      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[1].FemaleText
      value: "\u041B\u0443\u0447\u0448\u0435 \u044F \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u044E
        \u043D\u0430 \u043E\u043F\u0430\u0441\u043D\u043E\u0439 \u0448\u0430\u0445\u0442\u0435,
        \u0434\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438."
