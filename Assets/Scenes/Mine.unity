      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].maleNPCText
      value: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C,
        \u043D\u043E \u0432\u0445\u043E\u0434 \u0432 \u0448\u0430\u0445\u0442\u0443
        \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0430\u043A\u0440\u044B\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].maleNPCText
      value: "\u041C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u0440\u0430\u0441\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0442\u044C
        \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C
        \u043B\u0438\u0446\u0430\u043C, \u043D\u043E, \u0441 \u0434\u0440\u0443\u0433\u043E\u0439
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
        \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C. \u041C\u044B \u043E\u0434\u043D\u0430
        \u0438\u0437 \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u0433\u0440\u0443\u043F\u043F,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0445\u043E\u0442\u044F\u0442\u0441\u044F
        \u0437\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
        \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0439
        \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u0434\u043B\u044F \u043D\u0430\u0443\u043A\u0438,
        \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
        \u0420\u041D\u041E \u0438\u043B\u0438 \u0420\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435 
        \u041D\u0435\u043E\u043F\u043E\u0437\u043D\u0430\u043D\u043D\u044B\u0435
        \u041E\u0431\u044A\u0435\u043A\u0442\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].maleNPCText
      value: "\u0420\u041D\u041E \u211613 \u0438\u043C\u0435\u0435\u0442 \u0432\u0438\u0434
        \u043A\u0430\u043C\u043D\u044F, \u0434\u0430, \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
        \u043A\u0430\u043C\u043D\u044F, \u043D\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
        \u0442\u044F\u0436\u0435\u043B\u043E\u0433\u043E \u043A\u0430\u043C\u043D\u044F.
        \u0415\u0433\u043E \u043C\u0430\u0441\u0441\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439. \u041D\u043E
        \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u043D\u0435 \u0432 \u0435\u0433\u043E
        \u0432\u0435\u0441\u0435, \u0445\u043E\u0442\u044F \u044D\u0442\u043E \u0442\u043E\u0436\u0435,
        \u0430 \u0432 \u0431\u0435\u0441\u043A\u043E\u0436\u0438\u0445 \u0443\u0431\u043B\u044E\u0434\u043A\u0430\u0445,
        \u0435\u0431\u0443\u0447\u0438\u0435 \u0444\u0430\u043D\u0430\u0442\u0438\u043A\u0438
        \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0440\u0430\u0437
        \u043E\u0431\u043B\u0435\u043F\u0438\u043B\u0438 \u043D\u0430\u0448\u0435
        \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].maleNPCText
      value: "\u042D\u0442\u043E \u0441\u043D\u043E\u0432\u0430 \u0442\u044B?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].maleNPCText
      value: "\u0428\u0430\u043D\u0441\u044B \u0442\u0432\u043E\u0438 \u043E\u0447\u0435\u043D\u044C
        \u043C\u0430\u043B\u044B, \u043D\u043E \u0432\u0441\u0435\u0433\u0434\u0430
        \u0435\u0441\u0442\u044C \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
        \u043D\u0430 \u0432\u044B\u043F\u0430\u0434\u0435\u043D\u0438\u0435 \u043D\u0443\u043B\u044F
        \u0432 \u0440\u0443\u043B\u0435\u0442\u043A\u0435. \u0415\u0441\u043B\u0438
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F, \u0442\u043E \u043E\u0442\u043D\u0435\u0441\u0438
        \u0420\u041D\u041E \u211613 \u0432 \u041D\u0430\u0443\u0447\u043D\u044B\u0439
        \u0426\u0435\u043D\u0442\u0440. \u042F \u0435\u0433\u043E \u043E\u0442\u043C\u0435\u0442\u0438\u043B
        \u043D\u0430 \u0442\u0432\u043E\u0435\u0439 \u043A\u0430\u0440\u0442\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].maleNPCText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].maleNPCText
      value: "\u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C
        \u041D\u0430\u0443\u0447\u043D\u043E\u043C \u0426\u0435\u043D\u0442\u0440\u0435,
        \u0447\u0442\u043E \u0433\u0440\u0443\u043F\u043F\u0430 \"\u0420\u0443\u0434\u043D\u0438\u043A\"
        \u0441 \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C \u0438 \u0431\u0435\u0437
        \u043F\u043E\u0442\u0435\u0440\u044C \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
        \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].maleNPCText
      value: "\u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0443\u043F\u044B\u0435
        \u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0435
        \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0434\u0443\u043C\u044B\u0432\u0430\u0442\u044C
        \u0438\u0434\u0438\u043E\u0442\u0441\u043A\u0438\u0435 \u0438 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435
        \u043F\u043E\u0437\u044B\u0432\u043D\u044B\u0435. \u0423 \u043D\u0430\u0441
        \u0436\u0435 \u0432\u0441\u0435 \u043F\u0440\u043E\u0441\u0442\u043E, \u0435\u0441\u043B\u0438
        \u0433\u0440\u0443\u043F\u043F\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438
        \u0432 \u043B\u0435\u0441, \u0442\u043E \u044D\u0442\u043E \u0433\u0440\u0443\u043F\u043F\u0430
        \"\u041B\u0435\u0441\", \u0442\u0430\u043A \u0436\u0435 \u0438 \u0441 \u043D\u0430\u043C\u0438.
        \u041A\u0440\u0430\u0442\u043A\u043E \u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].maleNPCText
      value: "\u041D\u0430\u0443\u043A\u0430 \u043D\u0435 \u0436\u0434\u0435\u0442,
        \u0434\u0440\u0443\u0433 \u043C\u043E\u0439, \u0434\u043E\u0431\u0443\u0434\u044C
        \u0420\u041D\u041E \u211613 \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u044C
        \u0435\u0433\u043E \u0432 \u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u0426\u0435\u043D\u0442\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].maleNPCText
      value: "\u041A\u0443\u0434\u0430 \u0436\u0435 \u043C\u044B \u043F\u043E\u0439\u0434\u0435\u043C?
        \u041D\u0430\u043C \u043D\u0435\u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438,
        \u043D\u0430\u0445\u0443\u0439! \u041C\u044B \u0436\u0435 \u043D\u0435 \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B,
        \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u044B!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].maleNPCText
      value: "\u0421\u0435\u0439\u0447\u0430\u0441 \u044F \u0441\u044A\u0435\u0437\u0436\u0443
        \u0442\u0435\u0431\u0435 \u043F\u043E \u0435\u0431\u0430\u043B\u0443!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].maleNPCText
      value: "\u041B\u0430\u0434\u043D\u043E, \u0435\u0449\u0435 \u043F\u043E\u0434\u043E\u0436\u0434\u0435\u043C,
        \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u043B\u044F\u0436\u0435\u0442\u0441\u044F.
        \u0414\u0435\u0440\u0436\u0438 \u0431\u0430\u0431\u043A\u0438, \u044D\u0442\u043E
        \u0437\u0430 \u043D\u0430\u0441 \u0442\u0440\u043E\u0438\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].maleNPCText
      value: "\u0417\u0430\u0435\u0431\u0430\u043B \u043C\u043D\u0435 \u0437\u0443\u0431\u044B
        \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C,
        \u043A\u0440\u044B\u0441\u0430 \u0435\u0431\u043B\u0438\u0432\u0430\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].maleNPCText
      value: "\u041A\u0430\u043A \u0436\u0435 \u043C\u0435\u043D\u044F \u0432\u0441\u0435
        \u0437\u0430\u0435\u0431\u0430\u043B\u043E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].maleNPCText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].femaleNPCText
      value: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C,
        \u043D\u043E \u0432\u0445\u043E\u0434 \u0432 \u0448\u0430\u0445\u0442\u0443
        \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0430\u043A\u0440\u044B\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].femaleNPCText
      value: "\u042D\u0442\u043E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
        \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E... \u041B\u0430\u0434\u043D\u043E,
        \u0447\u0435\u0433\u043E \u0443\u0436 \u0442\u0430\u043C, \u0432\u0441\u0435
        \u0440\u0430\u0432\u043D\u043E \u0436\u0435\u043D\u0449\u0438\u043D\u0430
        \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u0439\u043C\u0435\u0442.
        \u041C\u044B \u043E\u0434\u043D\u0430 \u0438\u0437 \u043D\u0430\u0443\u0447\u043D\u044B\u0445
        \u0433\u0440\u0443\u043F\u043F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043E\u0445\u043E\u0442\u044F\u0442\u0441\u044F \u0437\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
        \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0439
        \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u0434\u043B\u044F \u043D\u0430\u0443\u043A\u0438,
        \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
        \u0420\u041D\u041E \u0438\u043B\u0438 \u0420\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
        \u041D\u0435\u043E\u043F\u043E\u0437\u043D\u0430\u043D\u043D\u044B\u0435
        \u041E\u0431\u044A\u0435\u043A\u0442\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].femaleNPCText
      value: "\u0420\u041D\u041E \u211613 \u0438\u043C\u0435\u0435\u0442 \u0432\u0438\u0434
        \u043A\u0430\u043C\u043D\u044F, \u0434\u0430, \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
        \u043A\u0430\u043C\u043D\u044F, \u043D\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
        \u0442\u044F\u0436\u0435\u043B\u043E\u0433\u043E \u043A\u0430\u043C\u043D\u044F.
        \u0415\u0433\u043E \u043C\u0430\u0441\u0441\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439. \u041D\u043E
        \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u043D\u0435 \u0432 \u0435\u0433\u043E
        \u0432\u0435\u0441\u0435, \u0445\u043E\u0442\u044F \u044D\u0442\u043E \u0442\u043E\u0436\u0435,
        \u0430 \u0432 \u0431\u0435\u0441\u043A\u043E\u0436\u0438\u0445 \u0443\u0431\u043B\u044E\u0434\u043A\u0430\u0445,
        \u0435\u0431\u0443\u0447\u0438\u0435 \u0444\u0430\u043D\u0430\u0442\u0438\u043A\u0438
        \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0440\u0430\u0437
        \u043E\u0431\u043B\u0435\u043F\u0438\u043B\u0438 \u043D\u0430\u0448\u0435
        \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435! \u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
        \u0434\u043B\u044F \u0432\u0430\u0441 \u044D\u0442\u043E \u043D\u0435\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043C\u043E,
        \u043D\u043E \u043F\u043E\u0432\u0435\u0440\u044C\u0442\u0435, \u0435\u0441\u0442\u044C
        \u0432\u0435\u0449\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0436\u0435\u043D\u0449\u0438\u043D\u044B
        \u043D\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u043F\u043E\u043D\u044F\u0442\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].femaleNPCText
      value: "\u042D\u0442\u043E \u0441\u043D\u043E\u0432\u0430 \u0442\u044B?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].femaleNPCText
      value: "\u0422\u044B, \u0436\u0435\u043D\u0449\u0438\u043D\u0430, \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
        \u0447\u0442\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F
        \u0441 \u044D\u0442\u0438\u043C \u0432\u044B\u0431\u0440\u043E\u0441\u043E\u043C
        \u043F\u0440\u0438\u0440\u043E\u0434\u044B? \u041D\u0435 \u0441\u043C\u0435\u0448\u0438
        \u043C\u0435\u043D\u044F \u0438 \u043C\u043E\u0438\u0445 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u043E\u0432!
        \u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
        \u0435\u0441\u043B\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
        \u0431\u0443\u0434\u0443\u0442 \u043D\u0430 \u0442\u0432\u043E\u0435\u0439
        \u0441\u0442\u043E\u0440\u043E\u043D\u0435, \u0447\u0442\u043E \u043E\u0447\u0435\u043D\u044C
        \u043C\u0430\u043B\u043E\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
        \u0442\u043E \u043E\u0442\u043D\u0435\u0441\u0438 \u043A\u0430\u043C\u0435\u043D\u044C
        \u0432 \u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u0426\u0435\u043D\u0442\u0440.
        \u041D\u0435 \u0434\u0443\u043C\u0430\u043B \u044F, \u0447\u0442\u043E \u0431\u0443\u0434\u0443
        \u043E\u0442\u043C\u0435\u0447\u0430\u0442\u044C \u0436\u0435\u043D\u0449\u0438\u043D\u0435
        \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u043D\u0430\u0448\u0435 \u043D\u0430\u0443\u0447\u043D\u043E\u0435
        \u043F\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0449\u0435..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].femaleNPCText
      value: "\u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0442\u0430\u043A\u0438\u0445
        \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0439 \u0432 \u0430\u0434\u0440\u0435\u0441
        \u043B\u044E\u0434\u0435\u0439 \u043D\u0430\u0443\u043A\u0438! \u042F \u043D\u0435
        \u0431\u044B\u043B \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432! \u0412\u0430\u0441,
        \u0436\u0435\u043D\u0449\u0438\u043D, \u043D\u0443\u0436\u043D\u043E \u0445\u0443\u044F\u0440\u0438\u0442\u044C
        \u043F\u0430\u043B\u043A\u043E\u0439, \u0447\u0442\u043E\u0431\u044B \u0432\u044B
        \u043D\u0435 \u0432\u044B\u0434\u0430\u0432\u0430\u043B\u0438 \u0442\u0430\u043A\u0438\u0445
        \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0439 \u0432 \u0430\u0434\u0440\u0435\u0441
        \u043B\u044E\u0434\u0435\u0439 \u043D\u0430\u0443\u043A\u0438!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].femaleNPCText
      value: "\u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C
        \u041D\u0430\u0443\u0447\u043D\u043E\u043C \u0426\u0435\u043D\u0442\u0440\u0435,
        \u0447\u0442\u043E \u0433\u0440\u0443\u043F\u043F\u0430 \"\u0420\u0443\u0434\u043D\u0438\u043A\"
        \u0441 \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C \u0438 \u0431\u0435\u0437
        \u043F\u043E\u0442\u0435\u0440\u044C \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
        \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].femaleNPCText
      value: "\u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0443\u043F\u044B\u0435
        \u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0435
        \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0434\u0443\u043C\u044B\u0432\u0430\u0442\u044C
        \u0438\u0434\u0438\u043E\u0442\u0441\u043A\u0438\u0435 \u0438 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435
        \u043F\u043E\u0437\u044B\u0432\u043D\u044B\u0435. \u0423 \u043D\u0430\u0441
        \u0436\u0435 \u0432\u0441\u0435 \u043F\u0440\u043E\u0441\u0442\u043E, \u0435\u0441\u043B\u0438
        \u0433\u0440\u0443\u043F\u043F\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438
        \u0432 \u043B\u0435\u0441, \u0442\u043E \u044D\u0442\u043E \u0433\u0440\u0443\u043F\u043F\u0430
        \"\u041B\u0435\u0441\", \u0442\u0430\u043A \u0436\u0435 \u0438 \u0441 \u043D\u0430\u043C\u0438.
        \u041A\u0440\u0430\u0442\u043A\u043E \u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].femaleNPCText
      value: "\u041F\u043E\u0441\u043B\u0443\u0436\u0438 \u043D\u0430\u0443\u043A\u0435,
        \u0436\u0435\u043D\u0449\u0438\u043D\u0430, \u0434\u043E\u0431\u0443\u0434\u044C
        \u0420\u041D\u041E \u211613 \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u044C
        \u0435\u0433\u043E \u0432 \u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u0426\u0435\u043D\u0442\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].femaleNPCText
      value: "\u041A\u0443\u0434\u0430 \u0436\u0435 \u043C\u044B \u043F\u043E\u0439\u0434\u0435\u043C?
        \u041D\u0430\u043C \u043D\u0435\u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438,
        \u043D\u0430\u0445\u0443\u0439! \u041C\u044B \u0436\u0435 \u043D\u0435 \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B,
        \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u044B!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engMaleNPCText
      value: I'm sorry, but the entrance to the mine is now closed.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].femaleNPCText
      value: "\u0421\u0435\u0439\u0447\u0430\u0441 \u044F \u0441\u044A\u0435\u0437\u0436\u0443
        \u0442\u0435\u0431\u0435 \u043F\u043E \u0435\u0431\u0430\u043B\u0443!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].femaleNPCText
      value: "\u041B\u0430\u0434\u043D\u043E, \u0435\u0449\u0435 \u043F\u043E\u0434\u043E\u0436\u0434\u0435\u043C,
        \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u043B\u044F\u0436\u0435\u0442\u0441\u044F.
        \u0414\u0435\u0440\u0436\u0438 \u0431\u0430\u0431\u043A\u0438, \u044D\u0442\u043E
        \u0437\u0430 \u043D\u0430\u0441 \u0442\u0440\u043E\u0438\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].femaleNPCText
      value: "\u0417\u0430\u0435\u0431\u0430\u043B\u0430 \u043C\u043D\u0435 \u0437\u0443\u0431\u044B
        \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C,
        \u0441\u0443\u043A\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].femaleNPCText
      value: "\u041A\u0430\u043A \u0436\u0435 \u043C\u0435\u043D\u044F \u0432\u0441\u0435
        \u0437\u0430\u0435\u0431\u0430\u043B\u043E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].femaleNPCText
      value: "\u0414\u0430\u0432\u0430\u0439-\u0434\u0430\u0432\u0430\u0439, \u043F\u0438\u0437\u0434\u0443\u0439
        \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u0445\u0430\u0445\u0430\u043B\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].engMaleNPCText
      value: We cannot declassify information to outsiders, but on the other hand,
        you can help us. We are one of the scientific groups that hunt for objects
        that are of some interest to science, in other words, URO or Unidentified
        Radioactive Objects.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].engMaleNPCText
      value: "URO \u211613 has the appearance of a stone, yes, an ordinary story,
        but an incredibly heavy stone. Its mass is abnormal. But the problem isn't
        with his weight, although that's all the case, but with the skinless bastards,
        the fucking fanatics have once again swarmed over our treasure!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].engMaleNPCText
      value: Is that you again?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].engMaleNPCText
      value: "Your chances are very small, but there is always a chance of a zero
        at roulette. If possible, take URO \u211613 to the Science Center. I marked
        it on your map."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].engMaleNPCText
      value: Make sure to inform the Science Center that the "Mine" group has completed
        the mission with distinction and without losses.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].engMaleNPCText
      value: "Only stupid soldiers can come up with idiotic and incomprehensible
        call signs. With us it's simple, if a group is sent to the forest, it's a
        group \u201CForest\u201D, the same with us. Short and simple."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].engMaleNPCText
      value: "Science doesn't wait, my friend, get URO \u211613 and bring it to the
        Science Center."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engFemaleNPCText
      value: I'm sorry, but the entrance to the mine is now closed.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].engFemaleNPCText
      value: This information is completely... Well, it's no big deal, the woman
        wouldn't understand it anyway. We are one of the scientific groups that hunt
        for objects that are of some interest to science, in other words, URO or
        Unidentified Radioactive Objects.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].engFemaleNPCText
      value: "URO \u211613 has the appearance of a stone, yes, an ordinary story,
        but an incredibly heavy stone. Its mass is abnormal. But the problem isn't
        with his weight, although that's all the case, but with the skinless bastards,
        the fucking fanatics have once again swarmed over our treasure! I know it's
        inexplicable to you, but believe me, there are things that women can't understand."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].engFemaleNPCText
      value: Is that you again?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].engFemaleNPCText
      value: Do you, a woman, think you can handle this outburst of nature? Don't
        make me and my partners laugh! In any case, if the variables are on your
        side, which is very unlikely, then take the stone to the Science Center.
        I did not think that I would mark our scientific haven on the map for a woman...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].engFemaleNPCText
      value: No such expressions about people of science! I wasn't happy! You women
        need to be fucked with a stick so that you don't give out such expressions
        to people of science!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].engFemaleNPCText
      value: Make sure to inform the Science Center that the "Mine" group has completed
        the mission with distinction and without losses.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].engFemaleNPCText
      value: "Only stupid soldiers can come up with idiotic and incomprehensible
        call signs. With us it's simple, if a group is sent to the forest, it's a
        group \u201CForest\u201D, the same with us. Short and simple."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].engFemaleNPCText
      value: "Serve science, woman, get URO \u211613 and bring it to the Science
        Center."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].indonesianMaleNPCText
      value: Maaf, tapi pintu masuk tambang sekarang ditutup.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].indonesianMaleNPCText
      value: Kami tidak dapat mendeklasifikasi informasi kepada pihak ketiga, tetapi
        di sisi lain, Anda dapat membantu kami. Kami adalah salah satu kelompok ilmiah
        yang berburu benda-benda yang sangat menarik bagi sains, dengan kata lain,
        Benda Radiasi Tak Dikenal.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].indonesianMaleNPCText
      value: "RBTD \u211613 memiliki tampilan seperti batu, ya, batu biasa, tetapi
        batu yang sangat berat. Massanya tidak normal. Tapi masalahnya bukan pada
        berat badannya, meskipun itu juga masalahnya, tetapi dengan bajingan tanpa
        kulit, para fanatik sialan itu sekali lagi berpegang teguh pada harta kita!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].indonesianMaleNPCText
      value: Apakah kamu lagi?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].indonesianMaleNPCText
      value: "Peluang Anda sangat kecil, tetapi selalu ada peluang nol di roulette.
        Jika memungkinkan, bawa RBTD \u211613 ke Pusat Sains. Aku menandainya di
        petamu."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].indonesianMaleNPCText
      value: Jangan lupa untuk memberi tahu Pusat Ilmiah bahwa kelompok kami telah
        menyelesaikan tugas dengan terhormat dan tanpa kerugian.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].indonesianMaleNPCText
      value: Hanya personel militer yang bodoh yang dapat membuat tanda panggil yang
        bodoh dan tidak dapat dipahami. Bersama kami, semuanya sederhana, jika sebuah
        kelompok dikirim ke hutan, maka ini adalah kelompok "Hutan", sama halnya
        dengan kami. Singkat dan jelas.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].indonesianMaleNPCText
      value: "Sains tidak menunggu, sobat, dapatkan RBTD \u211613 dan kirimkan ke
        Pusat Ilmiah."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].indonesianFemaleNPCText
      value: Maaf, tapi pintu masuk tambang sekarang ditutup.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].indonesianFemaleNPCText
      value: Informasi ini sempurna... Yah, apa pun yang terjadi, wanita itu tetap
        tidak akan mengerti. Kami adalah salah satu kelompok ilmiah yang berburu
        benda-benda yang sangat menarik bagi sains, dengan kata lain, Benda Radiasi
        Tak Dikenal.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].indonesianFemaleNPCText
      value: "RBTD \u211613 memiliki tampilan seperti batu, ya, batu biasa, tetapi
        batu yang sangat berat. Massanya tidak normal. Tapi masalahnya bukan pada
        berat badannya, meskipun itu juga masalahnya, tetapi dengan bajingan tanpa
        kulit, para fanatik sialan itu sekali lagi berpegang teguh pada harta kita!
        Saya tahu itu tidak dapat dijelaskan bagi Anda, tetapi percayalah, ada hal-hal
        yang tidak dapat dipahami oleh wanita."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].indonesianFemaleNPCText
      value: Apakah kamu lagi?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].indonesianFemaleNPCText
      value: Apakah Anda, seorang wanita, berpikir Anda dapat mengatasi ledakan alam
        ini? Jangan membuat saya dan rekan saya tertawa! Bagaimanapun, jika variabelnya
        ada di pihak Anda, yang sangat tidak mungkin, maka bawalah batu itu ke Pusat
        Sains. Saya tidak berpikir bahwa saya akan menandai surga ilmiah kita di
        peta untuk seorang wanita...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].indonesianFemaleNPCText
      value: Tidak ada ungkapan seperti itu tentang orang-orang sains! Saya tidak
        senang! Kalian para wanita perlu disetubuhi dengan tongkat agar kalian tidak
        memberikan ekspresi seperti itu kepada orang-orang sains!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].indonesianFemaleNPCText
      value: Jangan lupa untuk memberi tahu Pusat Ilmiah bahwa kelompok kami telah
        menyelesaikan tugas dengan terhormat dan tanpa kerugian.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].indonesianFemaleNPCText
      value: Hanya personel militer yang bodoh yang dapat membuat tanda panggil yang
        bodoh dan tidak dapat dipahami. Bersama kami, semuanya sederhana, jika sebuah
        kelompok dikirim ke hutan, maka ini adalah kelompok "Hutan", sama halnya
        dengan kami. Singkat dan jelas.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].indonesianFemaleNPCText
      value: "Layani sains, wanita, dapatkan RBTD \u211613 dan kirimkan ke Pusat
        Sains."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].Fog
      value: 
      objectReference: {fileID: 1625870247}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].Fog
      value: 
      objectReference: {fileID: 1625870247}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[0].Text
      value: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
        \u0438 \u043F\u043E\u0447\u0435\u043C\u0443 \u0433\u0440\u0443\u043F\u043F\u0430
        \u0443\u0447\u0435\u043D\u044B\u0445 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u0437\u0434\u0435\u0441\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[1].Text
      value: "(\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E)"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[2].Text
      value: "\u041D\u0438\u0447\u0435\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].Text
      value: "\u0417\u0430 \u043A\u0430\u043A\u0438\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C
        \u0432\u044B \u043E\u0445\u043E\u0442\u0438\u0442\u0435\u0441\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[1].Text
      value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C
        \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u043C\u043E\u0433\u0443 \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C,
        \u0431\u0435\u0437 \u043C\u0435\u043D\u044F \u0432\u0430\u043C \u043D\u0435
        \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[1].Text
      value: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E, \u0443\u0434\u0430\u0447\u0438
        \u0432\u0430\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u0445\u043E\u0447\u0443 \u043F\u043E\u043C\u043E\u0447\u044C
        \u0432\u0430\u043C \u0434\u043E\u0431\u044B\u0442\u044C \u0420\u041D\u041E
        \u211613."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[1].Text
      value: "\u0423\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
        \u0440\u0430\u0437."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].Text
      value: "\u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
        \u044F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].Text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[0].Text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0433\u0440\u0443\u043F\u043F\u0430
        \"\u0420\u0443\u0434\u043D\u0438\u043A\"?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[1].Text
      value: "\u0425\u043E\u0440\u043E\u0448\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[0].Text
      value: "\u0420\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044C
        \u043D\u0435 \u0432\u0438\u043D\u043E\u0432\u0430\u0442, \u0447\u0442\u043E
        \u0443 \u043D\u0435\u0433\u043E \u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u044B!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[0].Skill
