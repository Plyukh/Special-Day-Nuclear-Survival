    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].maleNPCText
      value: "\u041A\u0442\u043E \u0432\u044B \u0442\u0430\u043A\u043E\u0439? \u0417\u0430\u0447\u0435\u043C
        \u0432\u044B \u0432\u0437\u043B\u043E\u043C\u0430\u043B\u0438 \u0434\u0432\u0435\u0440\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].maleNPCText
      value: "\u0411\u043E\u0436\u0435, \u0437\u0430 \u0447\u0442\u043E \u043C\u043D\u0435
        \u044D\u0442\u0438 \u043C\u0443\u0447\u0435\u043D\u0438\u044F? \u041D\u0435\u0443\u0436\u0435\u043B\u0438
        \u044F \u044D\u0442\u043E \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].maleNPCText
      value: "\u041A\u0430\u043A \u0431\u044B \u043D\u0435 \u0442\u0430\u043A! \u042D\u0442\u043E\u0442
        \u0434\u043E\u043C \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
        \u043D\u0430\u043C \u043E\u0447\u0435\u043D\u044C \u0434\u0430\u0432\u043D\u043E,
        \u0435\u0433\u043E \u0435\u0449\u0435 \u043C\u043E\u0439 \u0434\u0435\u0434
        \u0441 \u0431\u0430\u0431\u043A\u043E\u0439 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438,
        \u043A\u043E\u0433\u0434\u0430 \u0433\u043E\u0440\u0431\u0430\u0442\u0438\u043B\u0438\u0441\u044C
        \u043D\u0430 \u0448\u0430\u0445\u0442\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].maleNPCText
      value: "\u0414\u0430, \u043D\u043E \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0447\u0442\u043E \u0432\u0441\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F
        \u043D\u0435 \u0432 \u043B\u0443\u0447\u0448\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u0413\u043E\u0440\u043E\u0434 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0441\u044F,
        \u0430 \u043B\u044E\u0434\u0438 \u043D\u0435\u0442. \u0410\u043B\u0447\u043D\u043E\u0441\u0442\u044C,
        \u0433\u043D\u0435\u0432 \u0438 \u0443\u043D\u0438\u0436\u0435\u043D\u0438\u0435
        \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0438\u0445.
        \u041C\u044B \u0431\u044B \u0438 \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u044B\u043B\u0438
        \u0447\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438,
        \u043D\u043E \u0411\u043E\u0433 \u043D\u0435 \u0449\u0430\u0434\u0438\u0442
        \u043D\u0430\u0441..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].maleNPCText
      value: "\u042F \u0431\u044B \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430
        \u0441\u0435\u0442\u043E\u0432\u0430\u0442\u044C \u043D\u0430 \u0441\u0432\u043E\u044E
        \u0441\u0443\u0434\u044C\u0431\u0443. \u041D\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
        \u0432\u0435\u0449\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0431\u0438\u0432\u0430\u044E\u0442
        \u0432\u043E \u043C\u043D\u0435 \u043D\u0430\u0434\u0435\u0436\u0434\u0443
        \u043D\u0430 \u043B\u0443\u0447\u0448\u0435\u0435. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
        \u043C\u0443\u0436, \u043F\u043E\u0442\u043E\u043C \u0441\u044B\u043D..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].maleNPCText
      value: "\u0418\u0437\u0432\u0438\u043D\u0438, \u043D\u043E \u044F \u0431\u044B
        \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430 \u043E\u0431 \u044D\u0442\u043E\u043C
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].maleNPCText
      value: "\u041F\u043E\u043A\u0438\u043D\u044C \u043D\u0430\u0448 \u0434\u043E\u043C,
        \u0440\u0430\u0434\u0438 \u0411\u043E\u0433\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].maleNPCText
      value: "\u041C\u0443\u0436 \u043F\u043E\u0433\u0438\u0431 \u0432 \u044D\u0442\u043E\u0439
        \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0439 \u0448\u0430\u0445\u0442\u0435,
        \u0430 \u043C\u043E\u0439 \u0441\u044B\u043D \u0438\u0441\u0442\u043E\u0449\u0435\u043D,
        \u043E\u043D \u0434\u0430\u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043F\u0440\u043E\u0441\u0442\u043E
        \u043B\u0435\u0436\u0438\u0442, \u0432\u0441\u0442\u0430\u0442\u044C \u043C\u043E\u0436\u0435\u0442,
        \u043D\u043E \u0435\u043C\u0443 \u043E\u0447\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u043D\u043E.
        \u0411\u043E\u043B\u044C\u0448\u0435 \u0443 \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u043E\u0433\u043E
        \u043D\u0435\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].maleNPCText
      value: "\u0414\u0430, \u043E\u043D \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B
        \u0431\u044B\u0442\u044C \u043F\u043E\u0445\u043E\u0436\u0438\u043C \u043D\u0430
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043D\u043E \u043E\u043D
        \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u043C\u043E\u0438\u043C
        \u0441\u044B\u043D\u043E\u043C! \u0420\u0430\u043D\u044C\u0448\u0435 \u043E\u043D
        \u043C\u043E\u0433 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430
        \u0448\u0430\u0445\u0442\u0435 \u0438 \u0442\u0430\u043A\u0438\u043C, \u043D\u043E
        \u0447\u0442\u043E-\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B\u043E
        \u0435\u0433\u043E \u043D\u0430 \u044D\u0442\u0438\u0445 \u0448\u0430\u0445\u0442\u0430\u0445.
        \u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].maleNPCText
      value: "\u041A\u0430\u043A\u043E\u0439 \u0435\u0449\u0435 \u0434\u043E\u043A\u0442\u043E\u0440?
        \u0412\u044B, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0448\u0443\u0442\u0438\u0442\u0435!
        \u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u044B\u043D\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
        \u0438 \u043F\u043E\u0439\u0442\u0438 \u0438\u0441\u043A\u0430\u0442\u044C
        \u0432\u0440\u0430\u0447\u0430 \u0432 \u044D\u0442\u043E\u043C \u0433\u043D\u0438\u043B\u043E\u043C
        \u0433\u043E\u0440\u043E\u0434\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].maleNPCText
      value: "\u0423 \u043D\u0430\u0441 \u043D\u0435\u0442\u0443 \u0441\u0432\u044F\u0437\u0438.
        \u042F \u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
        \u043F\u0443\u0442\u043D\u0438\u043A\u0430 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u0434\u043E \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
        \u043F\u043E\u043C\u043E\u0449\u0438. \u041E\u043D \u0432\u0437\u044F\u043B
        \u043C\u043E\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B,
        \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u0439\u0434\u0435\u0442 \u0442\u0443\u0434\u0430,
        \u0442\u0430\u043A \u043A\u0430\u043A \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442,
        \u0447\u0442\u043E \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435
        \u0443\u0436\u0435 \u043D\u0435 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
        \u043F\u043E\u043C\u043E\u0449\u044C \u043D\u0430 \u0434\u043E\u043C\u0443,
        \u0431\u043E\u043B\u0435\u0435 \u0442\u043E\u0433\u043E, \u043E\u043D \u0441\u043A\u0430\u0437\u0430\u043B,
        \u0447\u0442\u043E \u043C\u043E\u0438\u0445 \u0434\u0435\u043D\u0435\u0433
        \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442,
        \u0438 \u0441\u043C\u044B\u043B\u0441\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].maleNPCText
      value: "\u042F \u0431\u0443\u0434\u0443 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
        \u0442\u0435\u0431\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430!
        \u042F \u0431\u0443\u0434\u0443 \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F
        \u0437\u0430 \u0442\u0435\u0431\u044F \u0434\u043E \u043A\u043E\u043D\u0446\u0430
        \u0436\u0438\u0437\u043D\u0438!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].maleNPCText
      value: "\u0422\u044B \u043F\u043E\u0434\u0430\u0440\u0438\u043B \u043C\u043D\u0435
        \u043D\u0430\u0434\u0435\u0436\u0434\u0443. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
        \u043D\u0435 \u0442\u0435\u0440\u044F\u0439 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].maleNPCText
      value: "\u0422\u044B \u043D\u0430\u0448\u0435\u043B \u0434\u043E\u043A\u0442\u043E\u0440\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].maleNPCText
      value: "\u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E
        \u043A\u0430\u043A \u0442\u0435\u0431\u044F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C,
        \u0437\u0430 \u0442\u043E \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043C\u043E\u0433
        \u0438 \u0441\u043F\u0430\u0441 \u043C\u043E\u0435\u0433\u043E \u0441\u044B\u043D\u0430.
        \u041D\u043E \u0443 \u043D\u0430\u0441 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435\u0442, \u043A\u0440\u043E\u043C\u0435 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u044F\u0449\u0438\u043A\u0430 \u043C\u043E\u0435\u0433\u043E \u043C\u0443\u0436\u0430.
        \u0412\u043E\u0442 \u043A\u043B\u044E\u0447\u0438, \u043C\u043E\u0436\u0435\u0448\u044C
        \u0432\u0437\u044F\u0442\u044C \u043E\u0442\u0442\u0443\u0434\u0430 \u0432\u0441\u0435,
        \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].maleNPCText
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435,
        \u0434\u0438\u0442\u044F \u043C\u043E\u0435. \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u0442\u0432\u043E\u0435\u0439
        \u0434\u043E\u0431\u0440\u043E\u0442\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].femaleNPCText
      value: "\u041A\u0442\u043E \u0432\u044B \u0442\u0430\u043A\u0430\u044F? \u0417\u0430\u0447\u0435\u043C
        \u0432\u044B \u0432\u0437\u043B\u043E\u043C\u0430\u043B\u0438 \u0434\u0432\u0435\u0440\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].femaleNPCText
      value: "\u0411\u043E\u0436\u0435, \u0437\u0430 \u0447\u0442\u043E \u043C\u043D\u0435
        \u044D\u0442\u0438 \u043C\u0443\u0447\u0435\u043D\u0438\u044F? \u041D\u0435\u0443\u0436\u0435\u043B\u0438
        \u044F \u044D\u0442\u043E \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].femaleNPCText
      value: "\u041A\u0430\u043A \u0431\u044B \u043D\u0435 \u0442\u0430\u043A! \u042D\u0442\u043E\u0442
        \u0434\u043E\u043C \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
        \u043D\u0430\u043C \u043E\u0447\u0435\u043D\u044C \u0434\u0430\u0432\u043D\u043E,
        \u0435\u0433\u043E \u0435\u0449\u0435 \u043C\u043E\u0439 \u0434\u0435\u0434
        \u0441 \u0431\u0430\u0431\u043A\u043E\u0439 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438,
        \u043A\u043E\u0433\u0434\u0430 \u0433\u043E\u0440\u0431\u0430\u0442\u0438\u043B\u0438\u0441\u044C
        \u043D\u0430 \u0448\u0430\u0445\u0442\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].femaleNPCText
      value: "\u0414\u0430, \u043D\u043E \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0447\u0442\u043E \u0432\u0441\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F
        \u043D\u0435 \u0432 \u043B\u0443\u0447\u0448\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u0413\u043E\u0440\u043E\u0434 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0441\u044F,
        \u0430 \u043B\u044E\u0434\u0438 \u043D\u0435\u0442. \u0410\u043B\u0447\u043D\u043E\u0441\u0442\u044C,
        \u0433\u043D\u0435\u0432 \u0438 \u0443\u043D\u0438\u0436\u0435\u043D\u0438\u0435
        \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0438\u0445.
        \u041C\u044B \u0431\u044B \u0438 \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u044B\u043B\u0438
        \u0447\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438,
        \u043D\u043E \u0411\u043E\u0433 \u043D\u0435 \u0449\u0430\u0434\u0438\u0442
        \u043D\u0430\u0441..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].femaleNPCText
      value: "\u042F \u0431\u044B \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430
        \u0441\u0435\u0442\u043E\u0432\u0430\u0442\u044C \u043D\u0430 \u0441\u0432\u043E\u044E
        \u0441\u0443\u0434\u044C\u0431\u0443. \u041D\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
        \u0432\u0435\u0449\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0431\u0438\u0432\u0430\u044E\u0442
        \u0432\u043E \u043C\u043D\u0435 \u043D\u0430\u0434\u0435\u0436\u0434\u0443
        \u043D\u0430 \u043B\u0443\u0447\u0448\u0435\u0435. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
        \u043C\u0443\u0436, \u043F\u043E\u0442\u043E\u043C \u0441\u044B\u043D..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].femaleNPCText
      value: "\u0418\u0437\u0432\u0438\u043D\u0438, \u043D\u043E \u044F \u0431\u044B
        \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430 \u043E\u0431 \u044D\u0442\u043E\u043C
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].femaleNPCText
      value: "\u041F\u043E\u043A\u0438\u043D\u044C \u043D\u0430\u0448 \u0434\u043E\u043C,
        \u0440\u0430\u0434\u0438 \u0411\u043E\u0433\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].femaleNPCText
      value: "\u041C\u0443\u0436 \u043F\u043E\u0433\u0438\u0431 \u0432 \u044D\u0442\u043E\u0439
        \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0439 \u0448\u0430\u0445\u0442\u0435,
        \u0430 \u043C\u043E\u0439 \u0441\u044B\u043D \u0438\u0441\u0442\u043E\u0449\u0435\u043D,
        \u043E\u043D \u0434\u0430\u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043F\u0440\u043E\u0441\u0442\u043E
        \u043B\u0435\u0436\u0438\u0442, \u0432\u0441\u0442\u0430\u0442\u044C \u043C\u043E\u0436\u0435\u0442,
        \u043D\u043E \u0435\u043C\u0443 \u043E\u0447\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u043D\u043E.
        \u0411\u043E\u043B\u044C\u0448\u0435 \u0443 \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u043E\u0433\u043E
        \u043D\u0435\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].femaleNPCText
      value: "\u0414\u0430, \u043E\u043D \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B
        \u0431\u044B\u0442\u044C \u043F\u043E\u0445\u043E\u0436\u0438\u043C \u043D\u0430
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043D\u043E \u043E\u043D
        \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u043C\u043E\u0438\u043C
        \u0441\u044B\u043D\u043E\u043C! \u0420\u0430\u043D\u044C\u0448\u0435 \u043E\u043D
        \u043C\u043E\u0433 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430
        \u0448\u0430\u0445\u0442\u0435 \u0438 \u0442\u0430\u043A\u0438\u043C, \u043D\u043E
        \u0447\u0442\u043E-\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B\u043E
        \u0435\u0433\u043E \u043D\u0430 \u044D\u0442\u0438\u0445 \u0448\u0430\u0445\u0442\u0430\u0445.
        \u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].femaleNPCText
      value: "\u041A\u0430\u043A\u043E\u0439 \u0435\u0449\u0435 \u0434\u043E\u043A\u0442\u043E\u0440?
        \u0412\u044B, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0448\u0443\u0442\u0438\u0442\u0435!
        \u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u044B\u043D\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
        \u0438 \u043F\u043E\u0439\u0442\u0438 \u0438\u0441\u043A\u0430\u0442\u044C
        \u0432\u0440\u0430\u0447\u0430 \u0432 \u044D\u0442\u043E\u043C \u0433\u043D\u0438\u043B\u043E\u043C
        \u0433\u043E\u0440\u043E\u0434\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engMaleNPCText
      value: Who are you? Why did you break in the door?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].femaleNPCText
      value: "\u0423 \u043D\u0430\u0441 \u043D\u0435\u0442\u0443 \u0441\u0432\u044F\u0437\u0438.
        \u042F \u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
        \u043F\u0443\u0442\u043D\u0438\u043A\u0430 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u0434\u043E \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
        \u043F\u043E\u043C\u043E\u0449\u0438. \u041E\u043D \u0432\u0437\u044F\u043B
        \u043C\u043E\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B,
        \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u0439\u0434\u0435\u0442 \u0442\u0443\u0434\u0430,
        \u0442\u0430\u043A \u043A\u0430\u043A \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442,
        \u0447\u0442\u043E \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435
        \u0443\u0436\u0435 \u043D\u0435 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
        \u043F\u043E\u043C\u043E\u0449\u044C \u043D\u0430 \u0434\u043E\u043C\u0443,
        \u0431\u043E\u043B\u0435\u0435 \u0442\u043E\u0433\u043E, \u043E\u043D \u0441\u043A\u0430\u0437\u0430\u043B,
        \u0447\u0442\u043E \u043C\u043E\u0438\u0445 \u0434\u0435\u043D\u0435\u0433
        \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442,
        \u0438 \u0441\u043C\u044B\u043B\u0441\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].femaleNPCText
      value: "\u042F \u0431\u0443\u0434\u0443 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
        \u0442\u0435\u0431\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430!
        \u042F \u0431\u0443\u0434\u0443 \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F
        \u0437\u0430 \u0442\u0435\u0431\u044F \u0434\u043E \u043A\u043E\u043D\u0446\u0430
        \u0436\u0438\u0437\u043D\u0438!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].femaleNPCText
      value: "\u0422\u044B \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0430 \u043C\u043D\u0435
        \u043D\u0430\u0434\u0435\u0436\u0434\u0443. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
        \u043D\u0435 \u0442\u0435\u0440\u044F\u0439 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].femaleNPCText
      value: "\u0422\u044B \u043D\u0430\u0448\u043B\u0430 \u0434\u043E\u043A\u0442\u043E\u0440\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].femaleNPCText
      value: "\u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E
        \u043A\u0430\u043A \u0442\u0435\u0431\u044F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C,
        \u0437\u0430 \u0442\u043E \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043C\u043E\u0433\u043B\u0430
        \u0438 \u0441\u043F\u0430\u0441\u043B\u0430 \u043C\u043E\u0435\u0433\u043E
        \u0441\u044B\u043D\u0430. \u041D\u043E \u0443 \u043D\u0430\u0441 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435\u0442, \u043A\u0440\u043E\u043C\u0435 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u044F\u0449\u0438\u043A\u0430 \u043C\u043E\u0435\u0433\u043E \u043C\u0443\u0436\u0430.
        \u0412\u043E\u0442 \u043A\u043B\u044E\u0447\u0438, \u043C\u043E\u0436\u0435\u0448\u044C
        \u0432\u0437\u044F\u0442\u044C \u043E\u0442\u0442\u0443\u0434\u0430 \u0432\u0441\u0435,
        \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].femaleNPCText
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435,
        \u0434\u0438\u0442\u044F \u043C\u043E\u0435. \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u0442\u0432\u043E\u0435\u0439
        \u0434\u043E\u0431\u0440\u043E\u0442\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].engMaleNPCText
      value: God, why do I have to suffer this? Do I deserve it?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].engMaleNPCText
      value: No way! We've owned this house for a long time, my grandfather and grandmother
        built it when they worked in the mine.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].engMaleNPCText
      value: Yeah, but I don't think things are going to change for the better. The
        city has changed, but the people haven't. Greed, anger and humiliation haunt
        them. We would continue to be honest people, but God does not spare us...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].engMaleNPCText
      value: I wouldn't want to bemoan my fate. But things happen that kill my hope
        for the best. First my husband, then my son.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].engMaleNPCText
      value: I'm sorry, but I'd rather not talk about it.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].engMaleNPCText
      value: Leave our house, for God's sake.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].engMaleNPCText
      value: My husband died in that damned mine, and my son is exhausted, he doesn't
        even say anything, he just lies there, he can get up, but he is in a lot
        of pain. I have no one else.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].engMaleNPCText
      value: Yes, he has ceased to look like a man, but he remains my son! He used
        to be able to work in the mines and such, but something has damaged him badly
        in these mines. I don't know what to do!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].engMaleNPCText
      value: What doctor? You gotta be kidding me! I can't leave my son alone and
        go looking for a doctor in this rotten town.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].engMaleNPCText
      value: We have no communication. I asked a traveler to go to the hospital and
        ask for help. He took my last money and said he would not go there because
        he already knew that the hospital does not provide home care anymore, moreover,
        he said that my money would not be enough and left.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].engMaleNPCText
      value: I will be eternally grateful to you! I will pray for you for the rest
        of my life!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].engMaleNPCText
      value: You gave me hope. Please don't waste any time.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].engMaleNPCText
      value: Did you find the doctor?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].engMaleNPCText
      value: I don't even know how to thank you for helping me and saving my son.
        But we have nothing but my husband's old drawer. Here are the keys, you can
        take whatever you need from there.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].engMaleNPCText
      value: Thank you, my child. I will never forget your kindness.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engFemaleNPCText
      value: Who are you? Why did you break in the door?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].engFemaleNPCText
      value: God, why do I have to suffer this? Do I deserve it?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].engFemaleNPCText
      value: No way! We've owned this house for a long time, my grandfather and grandmother
        built it when they worked in the mine.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].engFemaleNPCText
      value: Yeah, but I don't think things are going to change for the better. The
        city has changed, but the people haven't. Greed, anger and humiliation haunt
        them. We would continue to be honest people, but God does not spare us...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].engFemaleNPCText
      value: I wouldn't want to bemoan my fate. But things happen that kill my hope
        for the best. First my husband, then my son.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].engFemaleNPCText
      value: I'm sorry, but I'd rather not talk about it.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].engFemaleNPCText
      value: Leave our house, for God's sake.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].engFemaleNPCText
      value: My husband died in that damned mine, and my son is exhausted, he doesn't
        even say anything, he just lies there, he can get up, but he is in a lot
        of pain. I have no one else.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].engFemaleNPCText
      value: Yes, he has ceased to look like a man, but he remains my son! He used
        to be able to work in the mines and such, but something has damaged him badly
        in these mines. I don't know what to do!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].engFemaleNPCText
      value: What doctor? You gotta be kidding me! I can't leave my son alone and
        go looking for a doctor in this rotten town.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].engFemaleNPCText
      value: We have no communication. I asked a traveler to go to the hospital and
        ask for help. He took my last money and said he would not go there because
        he already knew that the hospital does not provide home care anymore, moreover,
        he said that my money would not be enough and left.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].engFemaleNPCText
      value: I will be eternally grateful to you! I will pray for you for the rest
        of my life!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].engFemaleNPCText
      value: You gave me hope. Please don't waste any time.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].engFemaleNPCText
      value: Did you find the doctor?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].engFemaleNPCText
      value: I don't even know how to thank you for helping and saving my son. But
        we have nothing but my husband's old drawer. Here are the keys, you can take
        whatever you need from there.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].engFemaleNPCText
      value: Thank you, my child. I will never forget your kindness.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].indonesianMaleNPCText
      value: Siapa kamu? Mengapa Anda mendobrak pintu?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].indonesianMaleNPCText
      value: Tuhan, mengapa saya harus menderita? Apakah saya benar-benar pantas
        mendapatkan ini?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].indonesianMaleNPCText
      value: Tidak mungkin! Rumah ini milik kami sejak lama, kakek-nenek saya membangunnya
        ketika mereka bekerja keras di tambang.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].indonesianMaleNPCText
      value: Ya, tetapi bagi saya tampaknya segalanya tidak akan berubah menjadi
        lebih baik. Kota telah berubah, tetapi rakyatnya belum. Keserakahan, kemarahan,
        dan penghinaan menghantui mereka. Kita akan terus menjadi orang yang jujur,
        tetapi Tuhan tidak mengampuni kita...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].indonesianMaleNPCText
      value: Saya tidak ingin mengeluh tentang nasib saya. Tetapi hal-hal yang terjadi
        membunuh harapan saya untuk yang terbaik. Pertama sang suami, lalu sang putra...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].indonesianMaleNPCText
      value: Maaf, tapi saya tidak ingin membicarakannya.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].indonesianMaleNPCText
      value: Tinggalkan rumah kami, demi Tuhan.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].indonesianMaleNPCText
      value: Suamiku meninggal di tambang terkutuk itu, dan putraku kelelahan, dia
        bahkan tidak mengatakan apa-apa, dia hanya berbaring di sana, dia bisa bangun,
        tapi dia sangat kesakitan. Saya tidak punya orang lain.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].indonesianMaleNPCText
      value: Ya, dia berhenti terlihat seperti manusia, tapi dia tetap anakku! Dia
        dulu bisa bekerja di tambang seperti ini, tapi ada sesuatu yang merusaknya
        parah di tambang ini. Saya tidak tahu harus berbuat apa!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].indonesianMaleNPCText
      value: Dokter seperti apa? Kamu sepertinya bercanda! Saya tidak bisa meninggalkan
        anak saya sendirian dan pergi mencari dokter di kota yang busuk ini.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].indonesianMaleNPCText
      value: Kami tidak memiliki koneksi. Saya meminta seorang musafir untuk pergi
        ke rumah sakit dan meminta bantuan. Dia mengambil uang terakhir saya dan
        mengatakan bahwa dia tidak akan pergi ke sana, karena dia sudah tahu bahwa
        rumah sakit tidak lagi menyediakan perawatan di rumah, apalagi, dia mengatakan
        bahwa uang saya pasti tidak akan cukup, dan pergi.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].indonesianMaleNPCText
      value: Saya akan berterima kasih selamanya kepada Anda! Saya akan berdoa untuk
        Anda selama sisa hidup saya!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].indonesianMaleNPCText
      value: Kau memberiku harapan. Tolong jangan buang waktu.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].indonesianMaleNPCText
      value: Sudahkah Anda menemukan dokter?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].indonesianMaleNPCText
      value: Saya bahkan tidak tahu bagaimana mengucapkan terima kasih telah membantu
        dan menyelamatkan putra saya. Tapi kami tidak punya apa-apa selain kotak
        tua suamiku. Ini kuncinya, Anda dapat mengambil apa pun yang Anda butuhkan
        dari sana.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].indonesianMaleNPCText
      value: Terima kasih, anakku. Aku tidak akan pernah melupakan kebaikanmu.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].indonesianFemaleNPCText
      value: Siapa kamu? Mengapa Anda mendobrak pintu?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].indonesianFemaleNPCText
      value: Tuhan, mengapa saya harus menderita? Apakah saya benar-benar pantas
        mendapatkan ini?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].indonesianFemaleNPCText
      value: Tidak mungkin! Rumah ini milik kami sejak lama, kakek-nenek saya membangunnya
        ketika mereka bekerja keras di tambang.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].indonesianFemaleNPCText
      value: Ya, tetapi bagi saya tampaknya segalanya tidak akan berubah menjadi
        lebih baik. Kota telah berubah, tetapi rakyatnya belum. Keserakahan, kemarahan,
        dan penghinaan menghantui mereka. Kita akan terus menjadi orang yang jujur,
        tetapi Tuhan tidak mengampuni kita...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].indonesianFemaleNPCText
      value: Saya tidak ingin mengeluh tentang nasib saya. Tetapi hal-hal yang terjadi
        membunuh harapan saya untuk yang terbaik. Pertama sang suami, lalu sang putra...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].indonesianFemaleNPCText
      value: Maaf, tapi saya tidak ingin membicarakannya.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].indonesianFemaleNPCText
      value: Tinggalkan rumah kami, demi Tuhan.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].indonesianFemaleNPCText
      value: Suamiku meninggal di tambang terkutuk itu, dan putraku kelelahan, dia
        bahkan tidak mengatakan apa-apa, dia hanya berbaring di sana, dia bisa bangun,
        tapi dia sangat kesakitan. Saya tidak punya orang lain.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].indonesianFemaleNPCText
      value: Ya, dia berhenti terlihat seperti manusia, tapi dia tetap anakku! Dia
        dulu bisa bekerja di tambang seperti ini, tapi ada sesuatu yang merusaknya
        parah di tambang ini. Saya tidak tahu harus berbuat apa!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].indonesianFemaleNPCText
      value: Dokter seperti apa? Kamu sepertinya bercanda! Saya tidak bisa meninggalkan
        anak saya sendirian dan pergi mencari dokter di kota yang busuk ini.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].indonesianFemaleNPCText
      value: Kami tidak memiliki koneksi. Saya meminta seorang musafir untuk pergi
        ke rumah sakit dan meminta bantuan. Dia mengambil uang terakhir saya dan
        mengatakan bahwa dia tidak akan pergi ke sana, karena dia sudah tahu bahwa
        rumah sakit tidak lagi menyediakan perawatan di rumah, apalagi, dia mengatakan
        bahwa uang saya pasti tidak akan cukup, dan pergi.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].indonesianFemaleNPCText
      value: Saya akan berterima kasih selamanya kepada Anda! Saya akan berdoa untuk
        Anda selama sisa hidup saya!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].indonesianFemaleNPCText
      value: Kau memberiku harapan. Tolong jangan buang waktu.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].indonesianFemaleNPCText
      value: Sudahkah Anda menemukan dokter?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].indonesianFemaleNPCText
      value: Saya bahkan tidak tahu bagaimana mengucapkan terima kasih telah membantu
        dan menyelamatkan putra saya. Tapi kami tidak punya apa-apa selain kotak
        tua suamiku. Ini kuncinya, Anda dapat mengambil apa pun yang Anda butuhkan
        dari sana.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].indonesianFemaleNPCText
      value: Terima kasih, anakku. Aku tidak akan pernah melupakan kebaikanmu.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[0].Text
      value: "\u0422\u0435\u0431\u044F \u0435\u0431\u0430\u0442\u044C \u043D\u0435
        \u0434\u043E\u043B\u0436\u043D\u043E, \u0442\u0443\u043F\u0430\u044F \u043F\u0438\u0437\u0434\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[1].Text
      value: "\u041F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F,
        \u044F \u0434\u0443\u043C\u0430\u043B, \u044D\u0442\u043E\u0442 \u0434\u043E\u043C
        \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[2].Text
      value: "\u041D\u0438\u0447\u0435\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u0438\u0437\u0431\u0430\u0432\u043B\u044E \u0442\u0435\u0431\u044F
        \u043E\u0442 \u043C\u0443\u0447\u0435\u043D\u0438\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[1].Text
      value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C
        \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].Text
      value: "\u0412\u044B \u0438\u0437 \u0448\u0430\u0445\u0442\u0435\u0440\u0441\u043A\u043E\u0439
        \u0441\u0435\u043C\u044C\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].Text
      value: "\u0427\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
        \u0438\u043C\u0435\u043D\u043D\u043E \u0443 \u0432\u0430\u0441?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].Text
      value: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].Text
      value: "\u041D\u0438\u0447\u0435\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u043E\u0441\u0442\u0430\u0432\u043B\u044E \u0432\u0430\u0441."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[0].Text
      value: "\u0412\u044B \u0436\u0435 \u0432\u0438\u0434\u0438\u0442\u0435 \u0435\u0433\u043E!
        \u041E\u043D \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u0431\u043E\u0440\u043C\u043E\u0447\u0443\u0449\u0438\u0439
        \u0442\u0440\u0443\u043F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[0].Text
      value: "\u0412\u0430\u043C \u043D\u0443\u0436\u0435\u043D \u0434\u043E\u043A\u0442\u043E\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[1].Text
      value: "\u0411\u043E\u0436\u0435 \u043C\u043E\u0439, \u0443 \u0432\u0430\u0441
        \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043F\u0438\u0437\u0434\u0435\u0446.
        \u042F \u0443\u043C\u044B\u0432\u0430\u044E \u0440\u0443\u043A\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[0].Text
      value: "\u0412\u044B \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0438
        \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u0432\u0440\u0430\u0447\u0430
        \u043D\u0430 \u0434\u043E\u043C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[1].Quest
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[2].Skill
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.data[0].Text
      value: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u044F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E
        \u043D\u0430\u0439\u0442\u0438 \u0434\u043B\u044F \u0432\u0430\u0441 \u0434\u043E\u043A\u0442\u043E\u0440\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.data[1].Text
      value: "\u0414\u0430 \u0443\u0436... \u0416\u0435\u043B\u0430\u044E \u0443\u0434\u0430\u0447\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u0432\u0435\u0440\u043D\u0443\u0441\u044C, \u043A\u043E\u0433\u0434\u0430
        \u0431\u0443\u0434\u0443\u0442 \u043D\u043E\u0432\u043E\u0441\u0442\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].PlayerAnswer.Array.data[0].Text
      value: "\u0423 \u043C\u0435\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0435
        \u043D\u043E\u0432\u043E\u0441\u0442\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].PlayerAnswer.Array.data[1].Text
      value: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430, \u043E\u043D \u0441\u043A\u043E\u0440\u043E \u0431\u0443\u0434\u0435\u0442
        \u0443 \u0432\u0430\u0441."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].PlayerAnswer.Array.data[0].Text
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].PlayerAnswer.Array.data[0].Text
      value: "\u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].Quest
      value: -1
      objectReference: {fileID: 0}
