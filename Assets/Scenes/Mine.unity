      propertyPath: nodes.Array.data[16].PlayerAnswer.Array.data[0].FemaleText
      value: "\u041F\u0440\u0438\u044F\u0442\u043D\u043E \u0438\u043C\u0435\u0442\u044C
        \u0441 \u0432\u0430\u043C\u0438 \u0434\u0435\u043B\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[17].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0410 \u043F\u043E\u0447\u0435\u043C\u0443 \u0434\u0432\u0435\u0440\u044C
        \u0437\u0430\u043A\u0440\u044B\u0442\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[17].PlayerAnswer.Array.data[0].answerType
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[18].PlayerAnswer.Array.data[0].FemaleText
      value: "\u041D\u0430 \u0447\u0442\u043E \u043E\u043D\u0430 \u0436\u0438\u0432\u0435\u0442,
        \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
        \u0438\u0437 \u0434\u043E\u043C\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[19].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0412\u0441\u0435 \u044F\u0441\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[19].PlayerAnswer.Array.data[0].answerType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[20].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0414\u0430, \u044F \u0437\u0434\u0435\u0441\u044C \u0438\u043C\u0435\u043D\u043D\u043E
        \u0437\u0430 \u044D\u0442\u0438\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[20].PlayerAnswer.Array.data[0].answerType
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[20].PlayerAnswer.Array.data[1].FemaleText
      value: "\u041D\u0435\u0442, \u044F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
        \u043D\u0430 \u0448\u0430\u0445\u0442\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[20].PlayerAnswer.Array.data[2].FemaleText
      value: "\u0410 \u043A\u0442\u043E \u0436\u0438\u0432\u0435\u0442 \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C
        \u0434\u043E\u043C\u0435?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
