      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[1].FemaleText
      value: "\u0414\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u044D\u0442\u043E\u0433\u043E
        \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
