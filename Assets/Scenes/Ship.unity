    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[169].maleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[170].maleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].femaleNPCText
      value: "\u041C\u044B \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C
        \u0431\u0435\u0434\u043D\u044B\u0435 \u043B\u044E\u0434\u0438, \u0433\u0440\u0435\u0437\u044F\u0449\u0438\u0435
        \u043E \u0441\u0432\u043E\u0431\u043E\u0434\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].femaleNPCText
      value: "\u041D\u0430\u0448\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u0430
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438
        \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u0432 \u044D\u0442\u043E\u0439
        \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0439 \u043F\u043E\u0441\u0443\u0434\u0438\u043D\u0435.
        \u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u0435\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C,
        \u0441\u043B\u043E\u0432\u043E \"\u0441\u0432\u043E\u0431\u043E\u0434\u0430\"
        \u0443\u0436\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0441\u0442\u043E
        \u0441\u043B\u043E\u0432\u043E\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].femaleNPCText
      value: "\u0414\u0430, \u044D\u0442\u043E \u043D\u0430\u0448 \u043F\u0443\u0442\u044C
        \u043A \u0443\u0442\u043E\u043F\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].femaleNPCText
      value: "\u041D\u0435 \u0432\u0438\u0436\u0443 \u043D\u0438\u0447\u0435\u0433\u043E
        \u0433\u043B\u0443\u043F\u043E\u0433\u043E! \u0412\u0441\u0435 \u043C\u044B\u0441\u043B\u0438
        \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B, \u0434\u0430\u0436\u0435
        \u0442\u0430\u043A\u0430\u044F \u0441\u043B\u043E\u0436\u043D\u0430\u044F
        \u0437\u0430\u0434\u0430\u0447\u0430 \u043F\u043E\u0434 \u0441\u0438\u043B\u0443
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443! \u0410 \u044F! \u042F \u0436\u0435
        \u043D\u0435 \u043E\u0434\u0438\u043D! \u041D\u0430\u0441 \u0446\u0435\u043B\u0430\u044F
        \u0433\u0440\u0443\u043F\u043F\u0430! \u041C\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].femaleNPCText
      value: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0442
        \u0443\u0442\u043E\u043F\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].femaleNPCText
      value: "\u042F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A...
        \u042F \u043E\u0442\u0440\u0435\u043A\u0441\u044F \u043E\u0442 \u044D\u0442\u043E\u0433\u043E.
        \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0438 \u0434\u0430\u043B\u044C\u0448\u0435
        \u043D\u0430\u0441\u043C\u0435\u0445\u0430\u0442\u044C\u0441\u044F \u043D\u0430\u0434
        \u043D\u0430\u043C\u0438, \u043D\u043E \u0442\u044B \u0432\u0441\u0435 \u0435\u0449\u0435
        \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C
        \u043D\u0430\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].femaleNPCText
      value: "\u0422\u044B \u0441\u043D\u043E\u0432\u0430 \u0437\u0434\u0435\u0441\u044C,
        \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F
        \u043D\u0430\u0434 \u043D\u0430\u043C\u0438? "
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].femaleNPCText
      value: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430
        \u043D\u0430\u043C \u043D\u0443\u0436\u0435\u043D \u043F\u0443\u0442\u0435\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C.
        \u041D\u0443\u0436\u0435\u043D \u043A\u043E\u043C\u043F\u0430\u0441!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].femaleNPCText
      value: "\u041D\u0430 \u0442\u0432\u043E\u0435\u043C \u043C\u0435\u0441\u0442\u0435
        \u044F \u0431\u044B \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F
        \u043A \u0442\u0435\u043C, \u043A\u0442\u043E \u0432\u044B\u0445\u043E\u0434\u0438\u0442
        \u043D\u0430 \u0432\u043E\u0434\u0443. \u0422\u0443\u0442 \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438
        \u043E\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043B\u043E\u0434\u043E\u0447\u043D\u0438\u043A,
        \u044F \u0431\u044B \u0435\u0433\u043E \u043F\u043E\u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engMaleNPCText
      value: You're lucky to be here. Good afternoon.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].femaleNPCText
      value: "\u041D\u0430\u0448\u0435\u043B \u043A\u043E\u043C\u043F\u0430\u0441?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].femaleNPCText
      value: "\u042D\u0442\u043E\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
        \u0448\u0430\u0433 - \u0435\u0441\u0442\u044C \u043D\u0430\u0447\u0430\u043B\u043E
        \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u0434\u0435\u044F\u043D\u0438\u044F,
        \u0434\u0440\u0443\u0433 \u043C\u043E\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].femaleNPCText
      value: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433
        \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u0432\u0430\u0436\u043D\u044B\u0439.
        \u0422\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
        \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0432\u0441\u0435
        \u0441\u0432\u043E\u0438 \u043D\u0430\u0432\u044B\u043A\u0438 \u043E\u0431\u0430\u044F\u043D\u0438\u044F..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].femaleNPCText
      value: "\u0422\u044B \u043F\u0440\u0430\u0432\u0434\u0430 \u0445\u043E\u0447\u0435\u0448\u044C
        \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u043D\u0430\u0448
        \u043F\u0443\u0442\u044C \u043D\u0430 \u044D\u0442\u043E\u043C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].femaleNPCText
      value: "\u0427\u0442\u043E \u0436, \u044D\u0442\u043E \u0442\u0432\u043E\u0435
        \u043F\u0440\u0430\u0432\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].femaleNPCText
      value: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0442\u044B
        \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[16].femaleNPCText
      value: "\u041D\u0430\u043C \u043D\u0443\u0436\u0435\u043D \u043C\u0435\u0442\u0430\u043B\u043B,
        \u0430 \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435
        \u0434\u0435\u0442\u0430\u043B\u0438 \u0434\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u0412 \u0442\u0430\u043A\u043E\u043C
        \u0432\u043E\u043F\u0440\u043E\u0441\u0435 \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0436\u0435\u0442
        \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        - \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440. \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440
        \u0437\u0430\u0432\u043E\u0434\u0430 \u043F\u043E \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0435
        \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0445
        \u043E\u0442\u0445\u043E\u0434\u043E\u0432. \u042F \u043F\u043E\u043C\u0435\u0442\u0438\u043B
        \u0435\u0433\u043E \u043D\u0430 \u0442\u0432\u043E\u0435\u0439 \u043A\u0430\u0440\u0442\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[17].femaleNPCText
      value: "\u042D\u0442\u043E\u0442 \u0430\u0444\u0435\u0440\u0438\u0441\u0442
        - \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0432\u0437\u044F\u0442\u043E\u0447\u043D\u0438\u043A
        \u0438 \u0431\u0430\u043D\u0434\u0438\u0442! \u042F \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u043B
        \u0435\u0433\u043E \u0434\u043E\u043B\u0433\u0438\u0435 \u0433\u043E\u0434\u044B,
        \u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
        \u043D\u0430 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438. \u0421\u0435\u0439\u0447\u0430\u0441
        \u043E\u043D \u0443\u0436\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
        \u043C\u0435\u043D\u044F \u0431\u043E\u044F\u0442\u044C\u0441\u044F. \u042F
        \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u043D\u0430\u0439\u0442\u0438
        \u043A \u043D\u0435\u043C\u0443 \u043F\u043E\u0434\u0445\u043E\u0434... \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
        \u043F\u043E\u043C\u043E\u0447\u044C \u0435\u043C\u0443, \u0430 \u043E\u043D
        \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[18].femaleNPCText
      value: "\u0423 \u0442\u0435\u0431\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
        \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
        \u0441 \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u043E\u043C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[19].femaleNPCText
      value: "\u042F \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F
        \u0432 \u0442\u0435\u0431\u0435, \u0442\u043E\u0432\u0430\u0440\u0438\u0449.
        \u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
        \u044D\u0442\u043E \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
        \u0442\u0440\u0443\u0434\u043D\u043E! \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440
        \u0437\u0430\u0432\u043E\u0434\u0430 \u043D\u0435 \u0441\u0442\u0430\u043B
        \u0431\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C
        \u0441 \u043A\u0435\u043C-\u0442\u043E \u0441 \u0443\u043B\u0438\u0446\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].engMaleNPCText
      value: We are just poor people dreaming of freedom.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[20].femaleNPCText
      value: "\u041D\u0430\u0448\u0438 \u0434\u0435\u043B\u0430 \u0438\u0434\u0443\u0442,
        \u043A\u0430\u043A \u043D\u0435\u043B\u044C\u0437\u044F \u043B\u0443\u0447\u0448\u0435.
        \u0421\u0430\u043C\u043E\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0435
        \u043F\u043E\u0437\u0430\u0434\u0438, \u043E\u0441\u0442\u0430\u043B\u0441\u044F
        \u043E\u0434\u043D\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
        \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043A\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[21].femaleNPCText
      value: "\u041D\u0430\u0448\u0438 \u0438\u0434\u0435\u044E \u043F\u043E\u0440\u0442\u0438\u0442
        \u043E\u0434\u043D\u0430 \u0436\u0435\u043D\u0449\u0438\u043D\u0430. \u0414\u0430,
        \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C?!
        \u041A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u044B, \u0447\u0442\u043E
        \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E,
        \u043D\u043E \u043E\u043D\u0430 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442
        \u043D\u0430\u0448\u0443 \u0432\u0435\u0440\u0443 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u0435.
        \u0421\u0432\u043E\u0438\u043C \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043C
        \u043E\u043D\u0430 \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u043D\u0430\u0448\u0443
        \u043A\u043E\u043C\u0430\u043D\u0434\u0443. \u0423\u0431\u0435\u0436\u0434\u0430\u0435\u0442
        \u0432\u0441\u0435\u0445 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044C
        \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u043F\u043B\u044B\u0432\u0435\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[22].femaleNPCText
      value: "\u041A\u0430\u043A \u0437\u0430\u0447\u0435\u043C? \u042D\u0442\u043E
        \u0436\u0435 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E! \u041E\u043D\u0430
        \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u0434\u043C\u044F\u0442\u044C
        \u0432\u043B\u0430\u0441\u0442\u044C \u043F\u043E\u0434 \u0441\u0435\u0431\u044F.
        \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0435 \u0441\u0430\u043C\u0430
        \u043E\u043D\u0430 \u0445\u043E\u0447\u0435\u0442 \u0431\u044B\u0442\u044C
        \u043B\u0438\u0434\u0435\u0440\u043E\u043C \u043A\u043E\u0440\u0430\u0431\u043B\u044F,
        \u043D\u043E, \u044F \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E
        \u043A\u0442\u043E-\u0442\u043E \u0437\u0430 \u043D\u0435\u0439 \u0441\u0442\u043E\u0438\u0442.
        \u0418 \u044D\u0442\u043E\u0442 \u043A\u0442\u043E-\u0442\u043E \u0445\u043E\u0447\u0435\u0442
        \u0447\u0435\u0440\u0435\u0437 \u043C\u043E\u0442\u043E\u0440\u0438\u0441\u0442\u043A\u0443
        \u0443\u0431\u0440\u0430\u0442\u044C \u043C\u0435\u043D\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[23].femaleNPCText
      value: "\u042F \u0442\u0430\u043A \u0438 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E
        \u0442\u044B \u0443\u0436\u0435 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0441\u044F
        \u0435\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u044E. \u041C\u043D\u0435
        \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C
        \u043D\u0430\u043C \u0441 \u0442\u043E\u0431\u043E\u0439 \u043D\u0435 \u043F\u043E
        \u043F\u0443\u0442\u0438. \u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0435
        \u0432\u0440\u0435\u043C\u0435\u043D\u0430, \u044F \u0431\u044B \u0442\u0435\u0431\u044F
        \u043F\u043E\u0441\u0430\u0434\u0438\u043B, \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441
        \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[24].femaleNPCText
      value: "\u042F \u0432\u043E\u0437\u043B\u0430\u0433\u0430\u044E \u043D\u0430
        \u0442\u0435\u0431\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043D\u0430\u0434\u0435\u0436\u0434\u044B.
        \u041C\u043E\u0439 \u0442\u0435\u0431\u0435 \u0441\u043E\u0432\u0435\u0442:
        \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0439 \u0435\u0435,
        \u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0432\u0440\u0435\u0434\u0438\u0442\u044C,
        \u0434\u0430\u0436\u0435 \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u044F\u0441\u044C
        \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[25].femaleNPCText
      value: "\u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E
        \u0442\u044B \u0441 \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[26].femaleNPCText
      value: "\u0422\u044B \u0438\u0437\u0431\u0430\u0432\u0438\u043B\u0430\u0441\u044C
        \u043E\u0442 \u043D\u0435\u0435?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[27].femaleNPCText
      value: "\u042D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430. \u042F \u043D\u0435
        \u0437\u043D\u0430\u044E, \u043A\u0430\u043A \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
        \u0442\u0435\u0431\u044F. \u0423 \u043C\u0435\u043D\u044F \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435\u0442. \u041D\u043E \u0442\u044B \u0437\u043D\u0430\u0439, \u0447\u0442\u043E
        \u0442\u0443\u0442 \u0442\u0435\u0431\u044F \u0432\u0441\u0435\u0433\u0434\u0430
        \u0440\u0430\u0434\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[28].femaleNPCText
      value: "\u0422\u0435\u0431\u0435 \u043C\u0430\u043B\u043E \u0442\u043E\u0433\u043E,
        \u0447\u0442\u043E \u0442\u044B \u0441\u043F\u0430\u0441\u043B\u0430 \u0446\u0435\u043B\u043E\u0435
        \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E?! \u042F \u043D\u0435
        \u0437\u043D\u0430\u044E, \u0437\u0430\u0447\u0435\u043C \u0442\u044B \u0442\u043E\u0433\u0434\u0430
        \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[29].femaleNPCText
      value: "\u0423 \u043D\u0430\u0441 \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B
        \u043F\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044E.
        \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
        \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0437."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].engMaleNPCText
      value: Our freedom is symbolically enclosed in this broken vessel. When we
        restore it, the word "freedom" will no longer be just a word.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[30].femaleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[31].femaleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[32].femaleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[33].femaleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[34].femaleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[35].femaleNPCText
      value: "\u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
