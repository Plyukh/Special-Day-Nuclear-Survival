        \u043F\u043E\u043B\u043A\u0430\u043D \u0435\u0433\u043E \u043E\u0442\u0440\u0435\u043C\u043E\u043D\u0442\u0438\u0440\u0443\u0435\u0442,
        \u0438 \u043C\u044B \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u0436\u0438\u0432\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].femaleNPCText
      value: "\u0414\u0430, \u0437\u0430\u0436\u0438\u0432\u0435\u043C! \u0422\u043E\u043B\u044C\u043A\u043E
        \u044D\u0442\u0430 \u0442\u0443\u043F\u0430\u044F \u0441\u0443\u043A\u0430
        \u0436\u0438\u0442\u044C \u043D\u0435 \u0434\u0430\u0435\u0442! \u0412\u0441\u0435
        \u043F\u0438\u0437\u0434\u0438\u0442 \u0438 \u043F\u0438\u0437\u0434\u0438\u0442!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].femaleNPCText
      value: "\u0422\u0430\u043A \u0442\u043E\u0447\u043D\u043E! \u041E\u043F\u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u043D\u0430\u044F
        \u0431\u043B\u044F\u0434\u044C! \u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u0432\u044B\u043D\u043E\u0441\u0438\u043C\u043E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].femaleNPCText
      value: "\u0410\u0439, \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u0435\u0440\u0443\u043D\u0434\u044B!
        \u041A\u0430\u043A \u0436\u0435\u043D\u0449\u0438\u043D\u0430 \u0432\u043E\u043E\u0431\u0449\u0435
        \u043C\u043E\u0436\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C?!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].femaleNPCText
      value: "(\u042D\u0442\u043E\u0442 \u0434\u0436\u0435\u043D\u0442\u043B\u044C\u043C\u0435\u043D
        \u043F\u043B\u044E\u043D\u0443\u043B \u0432\u0430\u043C \u043F\u043E\u0434
        \u043D\u043E\u0433\u0438)"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].femaleNPCText
      value: "\u041F\u0440\u043E\u0435\u0437\u0434 \u0443\u043F\u043B\u0430\u0447\u0435\u043D.
        \u041E\u0442\u0447\u0430\u043B\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].femaleNPCText
      value: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E... \u0423 \u043C\u0435\u043D\u044F
        \u0437\u0430\u0432\u0430\u043B\u044F\u043B\u0441\u044F \u0433\u0440\u0435\u0431\u043D\u043E\u0439
        \u0432\u0438\u043D\u0442, \u043D\u043E \u0431\u0435\u0437 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430
        \u043E\u043D \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u0435\u043D.
        \u041D\u0430\u0439\u0434\u0435\u0448\u044C \u043C\u043D\u0435 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440
        - \u0431\u0443\u0434\u0443 \u0432\u043E\u0437\u0438\u0442\u044C \u0442\u0435\u0431\u044F
        \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E. \u041D\u043E \u0434\u043B\u044F
        \u0442\u0435\u0431\u044F, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430,
        \u044F \u0441\u0434\u0435\u043B\u0430\u044E \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engMaleNPCText
      value: Mmm...
