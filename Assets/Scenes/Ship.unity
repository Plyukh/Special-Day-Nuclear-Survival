    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].Text
      value: "\u0422\u044B \u043F\u043B\u0430\u0432\u0430\u0435\u0448\u044C \u043D\u0430
        \u044D\u0442\u0438\u0445 \u0434\u0435\u0440\u0435\u0432\u044F\u0448\u043A\u0430\u0445?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[1].Text
      value: "\u042F \u0438\u0449\u0443 \u043E\u0434\u043D\u0443 \u0434\u0435\u0432\u0447\u043E\u043D\u043A\u0443.
        \u041C\u043E\u0436\u0435\u0442 \u043E\u043D\u0430 \u0443 \u0432\u0430\u0441?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[3].Text
      value: "\u0423\u0445\u043E\u0436\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[23].PlayerAnswer.Array.data[0].Fog
      value: 
      objectReference: {fileID: 1207600143}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].Text
      value: "\u0418\u0437\u0432\u0438\u043D\u0438... \u0418\u0442\u0430\u043A, \u0433\u0434\u0435
        \u0442\u044B \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u043B\u0430\u0432\u0430\u0435\u0448\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[1].Text
      value: "\u041C\u0443\u0436\u0438\u043A, \u044D\u0442\u043E \u043F\u043E\u043B\u043D\u044B\u0439
        \u043F\u0438\u0437\u0434\u0435\u0446! \u041A\u0430\u043A \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
        \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u044D\u0442\u043E \"\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u043E\u0439\"?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[3].Text
      value: "\u0423\u0445\u043E\u0436\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[1].Text
      value: "\u041C\u0443\u0436\u0438\u043A, \u044D\u0442\u043E \u043F\u043E\u043B\u043D\u044B\u0439
        \u043F\u0438\u0437\u0434\u0435\u0446! \u041A\u0430\u043A \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
        \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u044D\u0442\u043E \"\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u043E\u0439\"?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[3].Text
      value: "\u0423\u0445\u043E\u0436\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].Text
      value: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u0431\u0435\u0440\u0435\u0448\u044C
        \u0437\u0430 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].Text
      value: "\u0422\u0435\u0445, \u043A\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0438
        \u043D\u0430 \u043B\u044E\u0434\u0435\u0439?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[3].Text
      value: "\u0423\u0445\u043E\u0436\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E... \u0421\u043A\u043E\u043B\u044C\u043A\u043E
        \u0442\u044B \u0431\u0435\u0440\u0435\u0448\u044C \u0437\u0430 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[1].Text
      value: "\u0422\u0435\u0445, \u043A\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0438
