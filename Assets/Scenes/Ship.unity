    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[17].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u044E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[18].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430, \u0434\u0435\u0442\u0430\u043B\u0438 \u043E\u043D \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[18].PlayerAnswer.Array.data[1].Text
      value: "\u042F \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[19].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430, \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[19].PlayerAnswer.Array.data[1].Text
      value: "\u042F \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
