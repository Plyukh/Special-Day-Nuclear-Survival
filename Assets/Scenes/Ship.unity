    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[20].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439. \u041A\u0430\u043A\u0430\u044F
        \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[20].PlayerAnswer.Array.data[1].Text
      value: "\u0417\u043D\u0430\u0435\u0448\u044C \u0447\u0442\u043E? \u0415\u0431\u0438\u0441\u044C
        \u0441 \u044D\u0442\u043E\u0439 \u0445\u0443\u0439\u043D\u0435\u0439 \u0441\u0430\u043C,
        \u043C\u0435\u043D\u044F \u0437\u0430\u0435\u0431\u0430\u043B\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[21].PlayerAnswer.Array.data[0].Text
      value: "\u0417\u0430\u0447\u0435\u043C \u0435\u0439 \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[21].PlayerAnswer.Array.data[1].Text
      value: "\u0417\u043D\u0430\u0435\u0448\u044C \u0447\u0442\u043E? \u0415\u0431\u0438\u0441\u044C
        \u0441 \u044D\u0442\u043E\u0439 \u0445\u0443\u0439\u043D\u0435\u0439 \u0441\u0430\u043C,
        \u043C\u0435\u043D\u044F \u0437\u0430\u0435\u0431\u0430\u043B\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[22].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u043D\u0435 \u0434\u043E\u043F\u0443\u0449\u0443 \u044D\u0442\u043E\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[22].PlayerAnswer.Array.data[1].Text
      value: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
        \u0442\u044B \u043F\u0435\u0440\u0435\u0433\u0438\u0431\u0430\u0435\u0448\u044C
        \u043F\u0430\u043B\u043A\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[23].PlayerAnswer.Array.data[0].Text
      value: "\u041E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[23].PlayerAnswer.Array.data[1].Text
      value: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
        \u0442\u044B \u043F\u0435\u0440\u0435\u0433\u0438\u0431\u0430\u0435\u0448\u044C
        \u043F\u0430\u043B\u043A\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[24].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u0442\u0435\u0431\u044F \u043F\u043E\u043D\u044F\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[25].PlayerAnswer.Array.data[0].Text
      value: "\u041D\u043E\u0432\u043E\u0441\u0442\u0438 \u043A\u0430\u043A \u043D\u0435\u043B\u044C\u0437\u044F
        \u043B\u0443\u0447\u0448\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[25].PlayerAnswer.Array.data[1].Text
      value: "\u042F \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[26].PlayerAnswer.Array.data[0].Text
      value: "\u041D\u0443, \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
        \u0442\u043E \u0432\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0438\u0442\u0435
        \u0443\u0442\u043E\u043F\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[26].PlayerAnswer.Array.data[1].Text
      value: "\u042F \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[27].PlayerAnswer.Array.data[0].Text
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[27].PlayerAnswer.Array.data[1].Text
      value: "\u042D\u0442\u043E \u0432\u0441\u0435?! \u041F\u0440\u043E\u0441\u0442\u043E
        \"\u0441\u043F\u0430\u0441\u0438\u0431\u043E\"?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[28].PlayerAnswer.Array.data[0].Text
      value: "\u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0432\u0438\u043D\u044C\u044F!
        \u042F \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u044E \u043D\u0443\u0436\u043D\u044B\u043C
        \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0442\u0435\u0431\u044F
        \u0432 \u0436\u0438\u0432\u044B\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[28].PlayerAnswer.Array.data[1].Text
      value: "\u041D\u0435\u0442, \u0442\u044B \u043F\u0440\u0430\u0432. \u042F \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0441\u044F,
        \u0438\u0437\u0432\u0438\u043D\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[29].PlayerAnswer.Array.data[0].Text
      value: "\u0411\u0435\u0437 \u043F\u0440\u043E\u0431\u043B\u0435\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[29].PlayerAnswer.Array.data[1].Text
      value: "\u041D\u0435\u0442, \u0442\u044B \u043F\u0440\u0430\u0432. \u042F \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0441\u044F,
        \u0438\u0437\u0432\u0438\u043D\u0438."
      objectReference: {fileID: 0}
