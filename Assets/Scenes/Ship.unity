    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[25].PlayerAnswer.Array.data[0].FemaleText
      value: "\u041D\u043E\u0432\u043E\u0441\u0442\u0438 \u043A\u0430\u043A \u043D\u0435\u043B\u044C\u0437\u044F
        \u043B\u0443\u0447\u0448\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[25].PlayerAnswer.Array.data[0].answerType
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[25].PlayerAnswer.Array.data[1].FemaleText
      value: "\u042F \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[25].PlayerAnswer.Array.data[1].answerType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[26].PlayerAnswer.Array.data[0].FemaleText
      value: "\u041D\u0443, \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
        \u0442\u043E \u0432\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0438\u0442\u0435
        \u0443\u0442\u043E\u043F\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[26].PlayerAnswer.Array.data[0].answerType
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[26].PlayerAnswer.Array.data[1].FemaleText
      value: "\u042F \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[26].PlayerAnswer.Array.data[1].answerType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[27].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[27].PlayerAnswer.Array.data[0].answerType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[27].PlayerAnswer.Array.data[1].FemaleText
      value: "\u042D\u0442\u043E \u0432\u0441\u0435?! \u041F\u0440\u043E\u0441\u0442\u043E
        \"\u0441\u043F\u0430\u0441\u0438\u0431\u043E\"?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[27].PlayerAnswer.Array.data[1].answerType
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[28].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0432\u0438\u043D\u044C\u044F!
        \u042F \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u044E \u043D\u0443\u0436\u043D\u044B\u043C
        \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0442\u0435\u0431\u044F
        \u0432 \u0436\u0438\u0432\u044B\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[28].PlayerAnswer.Array.data[0].answerType
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[28].PlayerAnswer.Array.data[1].FemaleText
      value: "\u041D\u0435\u0442, \u0442\u044B \u043F\u0440\u0430\u0432\u0430. \u042F
        \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0430\u0441\u044C, \u0438\u0437\u0432\u0438\u043D\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
