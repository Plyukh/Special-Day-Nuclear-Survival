      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[1].FemaleText
      value: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F?"
