      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].maleNPCText
      value: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043C\u044B \u0441\u043F\u0430\u0441\u0435\u043D\u044B?!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].maleNPCText
      value: "\u041C\u044B - \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F
        \u0433\u0440\u0443\u043F\u043F\u044B \"\u041C\u0430\u044F\u043A\". \u041D\u0430\u0448\u0435\u0439
        \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u0431\u044B\u043B\u043E \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C,
        \u0447\u0442\u043E \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442
        \u0437\u0435\u043B\u0435\u043D\u043E\u0435 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435
        \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].maleNPCText
      value: "\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C, \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D,
        \u043D\u043E \u043C\u043E\u0433\u0443 \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C,
        \u0447\u0442\u043E \u044D\u0442\u043E \u0420\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
        \u041D\u0435\u043E\u043F\u043E\u0437\u043D\u0430\u043D\u043D\u044B\u0439
        \u041E\u0431\u044A\u0435\u043A\u0442 \u211610. \u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435,
        \u0443\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0439, \u043F\u043E\u043C\u043E\u0433\u0438\u0442\u0435
        \u043D\u0430\u043C \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].maleNPCText
      value: "\u0422\u044B \u043E\u0441\u043B\u0435\u043F?! \u041C\u044B \u043F\u043E\u043F\u0430\u043B\u0438
        \u0432 \u0437\u0430\u043F\u0430\u0434\u043D\u044E. \u041F\u043E\u043A\u043E\u0439\u043D\u044B\u0439
        \u043B\u0438\u0434\u0435\u0440 \u0433\u0440\u0443\u043F\u043F\u044B \u0440\u0435\u0448\u0438\u043B,
        \u0447\u0442\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435
        \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
        \u043F\u0435\u0449\u0435\u0440\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].maleNPCText
      value: "\u0422\u044B \u0436\u0430\u043B\u043A\u0430\u044F \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u044F
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430! \u0423 \u0442\u0435\u0431\u044F
        \u043D\u0435\u0442 \u043D\u0438 \u043A\u0430\u043F\u043B\u0438 \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].maleNPCText
      value: "\u0414\u0430! \u041A\u043E\u0433\u0434\u0430 \u043F\u0443\u0442\u044C
        \u0431\u0443\u0434\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D,
        \u0434\u0430\u0439\u0442\u0435 \u043D\u0430\u043C \u0437\u043D\u0430\u0442\u044C.
        \u041C\u044B \u0431\u0443\u0434\u0435\u043C \u0436\u0434\u0430\u0442\u044C
        \u0437\u0434\u0435\u0441\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].maleNPCText
      value: "\u041F\u043B\u0435\u0432\u0430\u043B\u0438 \u043C\u044B \u043D\u0430
        \u044D\u0442\u043E\u0442 \u041E\u0431\u044A\u0435\u043A\u0442! \u0415\u0441\u043B\u0438
        \u0432\u0430\u043C \u0436\u0438\u0437\u043D\u044C \u043D\u0435 \u043C\u0438\u043B\u0430,
        \u0442\u043E \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F
        \u043D\u0430 \u0441\u0430\u043C\u044B\u0439 \u0432\u0435\u0440\u0445 \u043C\u0430\u044F\u043A\u0430,
        \u0432\u044B\u043A\u0440\u0430\u0441\u0442\u044C \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0435\u0433\u043E \u0432 \u0431\u0443\u043D\u043A\u0435\u0440 \u0443\u0447\u0435\u043D\u044B\u0445.
        \u042F \u0434\u0430\u0436\u0435 \u043F\u043E\u043C\u0435\u0447\u0443 \u0435\u0433\u043E
        \u0432\u0430\u043C \u043D\u0430 \u043A\u0430\u0440\u0442\u0430\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].maleNPCText
      value: "\u041D\u0443 \u0447\u0442\u043E \u0442\u0430\u043C? \u041F\u0443\u0441\u0442\u044C
        \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].maleNPCText
      value: "\u0412\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430\u043C
        \u0443\u0441\u043B\u0443\u0433\u0443 \u0446\u0435\u043D\u043E\u0439 \u0432
        \u0436\u0438\u0437\u043D\u044C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].maleNPCText
      value: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0443\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0439,
        \u043A\u043E\u043D\u0435\u0447\u043D\u043E! \u0415\u0449\u0435 \u0440\u0430\u0437
        \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0432\u0430\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].maleNPCText
      value: "\u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435
        \u0437\u0430 \u043D\u0430\u0441, \u043C\u044B \u0443\u0436\u0435 \u0443\u0445\u043E\u0434\u0438\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].maleNPCText
      value: "\u041B\u0430\u0434\u043D\u043E, \u0435\u0449\u0435 \u043F\u043E\u0434\u043E\u0436\u0434\u0435\u043C,
        \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u043B\u044F\u0436\u0435\u0442\u0441\u044F.
        \u0414\u0435\u0440\u0436\u0438 \u0431\u0430\u0431\u043A\u0438, \u044D\u0442\u043E
        \u0437\u0430 \u043D\u0430\u0441 \u0442\u0440\u043E\u0438\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].maleNPCText
      value: "\u0417\u0430\u0435\u0431\u0430\u043B \u043C\u043D\u0435 \u0437\u0443\u0431\u044B
        \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C,
        \u043A\u0440\u044B\u0441\u0430 \u0435\u0431\u043B\u0438\u0432\u0430\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].maleNPCText
      value: "\u041A\u0430\u043A \u0436\u0435 \u043C\u0435\u043D\u044F \u0432\u0441\u0435
        \u0437\u0430\u0435\u0431\u0430\u043B\u043E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].maleNPCText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].femaleNPCText
      value: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043C\u044B \u0441\u043F\u0430\u0441\u0435\u043D\u044B?!
        \u0410\u0430\u0430... \u0420\u0430\u043D\u043E \u0440\u0430\u0434\u0443\u0435\u043C\u0441\u044F...
        \u042D\u0442\u043E \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0434\u0435\u0432\u0447\u043E\u043D\u043A\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].femaleNPCText
      value: "\u041C\u044B - \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F
        \u0433\u0440\u0443\u043F\u043F\u044B \"\u041C\u0430\u044F\u043A\". \u041D\u0430\u0448\u0435\u0439
        \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u0431\u044B\u043B\u043E \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C,
        \u0447\u0442\u043E \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442
        \u0437\u0435\u043B\u0435\u043D\u043E\u0435 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435
        \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435. \u041D\u0435 \u0434\u0443\u043C\u0430\u044E,
        \u0447\u0442\u043E \u044D\u0442\u043E \u043E \u0447\u0435\u043C-\u0442\u043E
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0435\u0431\u0435 , \u0436\u0435\u043D\u0449\u0438\u043D\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].femaleNPCText
      value: "\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C, \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D,
        \u043D\u043E \u043C\u043E\u0433\u0443 \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C,
        \u0447\u0442\u043E \u044D\u0442\u043E \u0420\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
        \u041D\u0435\u043E\u043F\u043E\u0437\u043D\u0430\u043D\u043D\u044B\u0439
        \u041E\u0431\u044A\u0435\u043A\u0442 \u211610. \u0416\u0435\u043D\u0449\u0438\u043D\u0430,
        \u043D\u0435 \u0434\u0443\u0440\u0438 \u0433\u043E\u043B\u043E\u0432\u0443!
        \u041B\u0443\u0447\u0448\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438,
        \u043A\u0430\u043A \u043D\u0430\u043C \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u0438\u0437 \u044D\u0442\u043E\u0439 \u043F\u0435\u0440\u0435\u0434\u0440\u044F\u0433\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].femaleNPCText
      value: "\u0422\u044B \u043E\u0441\u043B\u0435\u043F\u043B\u0430?! \u041C\u044B
        \u043F\u043E\u043F\u0430\u043B\u0438 \u0432 \u0437\u0430\u043F\u0430\u0434\u043D\u044E.
        \u041F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u043B\u0438\u0434\u0435\u0440
        \u0433\u0440\u0443\u043F\u043F\u044B \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E
        \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435 \u0431\u0443\u0434\u0435\u0442
        \u043F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0449\u0435\u0440\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].femaleNPCText
      value: "\u0422\u044B \u0436\u0430\u043B\u043A\u0430\u044F \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u044F
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430! \u0423 \u0442\u0435\u0431\u044F
        \u043D\u0435\u0442 \u043D\u0438 \u043A\u0430\u043F\u043B\u0438 \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].femaleNPCText
      value: "\u0422\u044B \u043C\u0435\u043D\u044F \u0443\u0434\u0438\u0432\u043B\u044F\u0435\u0448\u044C,
        \u0436\u0435\u043D\u0449\u0438\u043D\u0430! \u041A\u043E\u0433\u0434\u0430
        \u043F\u0443\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D,
        \u0434\u0430\u0439\u0442\u0435 \u043D\u0430\u043C \u0437\u043D\u0430\u0442\u044C.
        \u041C\u044B \u0431\u0443\u0434\u0435\u043C \u0436\u0434\u0430\u0442\u044C
        \u0437\u0434\u0435\u0441\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].femaleNPCText
      value: "\u041F\u043B\u0435\u0432\u0430\u043B\u0438 \u043C\u044B \u043D\u0430
        \u044D\u0442\u043E\u0442 \u041E\u0431\u044A\u0435\u043A\u0442! \u0415\u0441\u043B\u0438
        \u0432\u0430\u043C \u0436\u0438\u0437\u043D\u044C \u043D\u0435 \u043C\u0438\u043B\u0430,
        \u0442\u043E \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F
        \u043D\u0430 \u0441\u0430\u043C\u044B\u0439 \u0432\u0435\u0440\u0445 \u043C\u0430\u044F\u043A\u0430,
        \u0432\u044B\u043A\u0440\u0430\u0441\u0442\u044C \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0435\u0433\u043E \u0432 \u0431\u0443\u043D\u043A\u0435\u0440 \u0443\u0447\u0435\u043D\u044B\u0445.
        \u042F \u0434\u0430\u0436\u0435 \u043F\u043E\u043C\u0435\u0447\u0443 \u0435\u0433\u043E
        \u0432\u0430\u043C \u043D\u0430 \u043A\u0430\u0440\u0442\u0430\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].femaleNPCText
      value: "\u041D\u0443 \u0447\u0442\u043E \u0442\u0430\u043C? \u041F\u0443\u0441\u0442\u044C
        \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].femaleNPCText
      value: "\u0412\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430\u043C
        \u0443\u0441\u043B\u0443\u0433\u0443 \u0446\u0435\u043D\u043E\u0439 \u0432
        \u0436\u0438\u0437\u043D\u044C! \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u044D\u0442\u043E\u0433\u043E,
        \u0436\u0435\u043D\u0449\u0438\u043D\u0430. \u042F \u0431\u0440\u043E\u0448\u0443
        \u044D\u0442\u0438 \u0434\u043E\u043D\u043A\u0438\u0445\u043E\u0442\u0441\u043A\u0438\u0435
        \u0438\u0434\u0435\u0438 \u0438 \u043D\u0430\u0447\u043D\u0443 \u0436\u0438\u0437\u043D\u044C
        \u0441 \u0447\u0438\u0441\u0442\u043E\u0433\u043E \u043B\u0438\u0441\u0442\u0430!
        \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0434\u0430\u0436\u0435
        \u0436\u0435\u043D\u044E\u0441\u044C..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].femaleNPCText
      value: "\u041E\u0447\u0435\u0432\u0438\u0434\u043D\u043E..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engMaleNPCText
      value: Are we really saved?!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].femaleNPCText
      value: "\u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435
        \u0437\u0430 \u043D\u0430\u0441, \u043C\u044B \u0443\u0436\u0435 \u0443\u0445\u043E\u0434\u0438\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].femaleNPCText
      value: "\u041B\u0430\u0434\u043D\u043E, \u0435\u0449\u0435 \u043F\u043E\u0434\u043E\u0436\u0434\u0435\u043C,
        \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u043B\u044F\u0436\u0435\u0442\u0441\u044F.
        \u0414\u0435\u0440\u0436\u0438 \u0431\u0430\u0431\u043A\u0438, \u044D\u0442\u043E
        \u0437\u0430 \u043D\u0430\u0441 \u0442\u0440\u043E\u0438\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].femaleNPCText
      value: "\u0417\u0430\u0435\u0431\u0430\u043B\u0430 \u043C\u043D\u0435 \u0437\u0443\u0431\u044B
        \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C,
        \u0441\u0443\u043A\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].femaleNPCText
      value: "\u041A\u0430\u043A \u0436\u0435 \u043C\u0435\u043D\u044F \u0432\u0441\u0435
        \u0437\u0430\u0435\u0431\u0430\u043B\u043E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].femaleNPCText
      value: "\u0414\u0430\u0432\u0430\u0439-\u0434\u0430\u0432\u0430\u0439, \u043F\u0438\u0437\u0434\u0443\u0439
        \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u0445\u0430\u0445\u0430\u043B\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].engMaleNPCText
      value: We are an expedition team from "Lighthouse". Our mission was to find
        out what causes the green glow on the island.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].engMaleNPCText
      value: "Not really, I'm not sure, but I can theoretically assume that this
        is Unidentified Radiation Object \u211610. Listen, dear, help us out."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].engMaleNPCText
      value: Are you blind?! We're trapped. The late leader of the group decided
        that it would be safer to go through the caves.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].engMaleNPCText
      value: You're a pathetic imitation of a human! You don't have any sympathy!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].engMaleNPCText
      value: Yes! When the way is clear, let us know. We'll be waiting here.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].engMaleNPCText
      value: We didn't give a damn about this Object! If you don't like life, then
        you can climb to the very top of the lighthouse, steal it and deliver it
        to the scientists' bunker. I'll even mark it for you on the maps.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].engMaleNPCText
      value: What's up? Let him be free?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].engMaleNPCText
      value: You have rendered us a service at the cost of a lifetime!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].engMaleNPCText
      value: Of course, dear, of course! Thank you again!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].engMaleNPCText
      value: Don't worry about us, we're already leaving.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].engFemaleNPCText
      value: Are we really saved?! Aaa... We rejoice early... It's some girl.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].engFemaleNPCText
      value: We are an expedition team from "Lighthouse". Our mission was to find
        out what causes the green glow on the island. I don't think that tells you
        anything, woman.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].engFemaleNPCText
      value: "Not really, I'm not sure, but I can theoretically assume that this
        is Unidentified Radiation Object \u211610. Woman, don't mess with my head!
        Why don't you tell me how we can get out of this mess?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].engFemaleNPCText
      value: Are you blind?! We're trapped. The late leader of the group decided
        that it would be safer to go through the caves.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].engFemaleNPCText
      value: You're a pathetic imitation of a human! You don't have any sympathy!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].engFemaleNPCText
      value: You surprise me, woman! When the way is clear, let us know. We'll be
        waiting here.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].engFemaleNPCText
      value: We didn't give a damn about this Object! If you don't like life, then
        you can climb to the very top of the lighthouse, steal it and deliver it
        to the scientists' bunker. I'll even mark it for you on the maps.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].engFemaleNPCText
      value: What's up? Let him be free?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].engFemaleNPCText
      value: You have rendered us a service at the cost of a lifetime! I'll never
        forget that, woman. I will give up these quixotic ideas and start my life
        with a clean slate! Maybe even get married...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].engFemaleNPCText
      value: Obviously...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].engFemaleNPCText
      value: Don't worry about us, we're already leaving.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].indonesianMaleNPCText
      value: Apakah kita benar-benar diselamatkan?!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].indonesianMaleNPCText
      value: Kami adalah ekspedisi kelompok "Mercusuar". Tugas kami adalah mencari
        tahu apa yang menyebarkan cahaya hijau di pulau itu.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].indonesianMaleNPCText
      value: "Tidak juga, saya tidak yakin, tetapi secara teoritis saya dapat berasumsi
        bahwa ini adalah Objek Tak Dikenal Radiasi \u211610. Dengar, sayang, bantu
        kami."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].indonesianMaleNPCText
      value: Apa kau buta?! Kita terjebak. Mendiang pemimpin kelompok memutuskan
        bahwa akan lebih aman untuk melewati gua-gua tersebut.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].indonesianMaleNPCText
      value: Kau tiruan manusia yang menyedihkan! Anda tidak memiliki simpati!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].indonesianMaleNPCText
      value: Ya! Jika jalannya sudah jelas, beri tahu kami. Kami akan menunggu di
        sini.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].indonesianMaleNPCText
      value: Kami tidak peduli dengan Objek ini! Jika Anda tidak menyukai kehidupan,
        maka Anda dapat mendaki ke puncak mercusuar, mencurinya, dan mengirimkannya
        ke bunker para ilmuwan. Aku bahkan akan menandainya untukmu di peta.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].indonesianMaleNPCText
      value: Ada apa? Biarkan dia bebas?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].indonesianMaleNPCText
      value: Anda telah memberi kami layanan dengan biaya seumur hidup!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].indonesianMaleNPCText
      value: Tentu saja sayang, tentu saja! Terima kasih lagi!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].indonesianMaleNPCText
      value: Jangan khawatir tentang kami, kami sudah pergi.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].indonesianFemaleNPCText
      value: Apakah kita benar-benar diselamatkan?! Aaa... Kami bersukacita lebih
        awal... Itu seorang gadis.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].indonesianFemaleNPCText
      value: Kami adalah ekspedisi kelompok "Mercusuar". Tugas kami adalah mencari
        tahu apa yang menyebarkan cahaya hijau di pulau itu. Kurasa itu tidak ada
        artinya bagimu, wanita.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].indonesianFemaleNPCText
      value: "Tidak juga, saya tidak yakin, tetapi secara teoritis saya dapat berasumsi
        bahwa ini adalah Objek Tak Dikenal Radiasi \u211610. Wanita, jangan bodoh!
        Katakan padaku, bagaimana kita keluar dari kekacauan ini?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].indonesianFemaleNPCText
      value: Apa kau buta?! Kita terjebak. Mendiang pemimpin kelompok memutuskan
        bahwa akan lebih aman untuk melewati gua-gua tersebut.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].indonesianFemaleNPCText
      value: Kau tiruan manusia yang menyedihkan! Anda tidak memiliki simpati!
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].indonesianFemaleNPCText
      value: Anda mengejutkan saya, wanita! Jika jalannya sudah jelas, beri tahu
        kami. Kami akan menunggu di sini.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].indonesianFemaleNPCText
      value: Kami tidak peduli dengan Objek ini! Jika Anda tidak menyukai kehidupan,
        maka Anda dapat mendaki ke puncak mercusuar, mencurinya, dan mengirimkannya
        ke bunker para ilmuwan. Aku bahkan akan menandainya untukmu di peta.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].indonesianFemaleNPCText
      value: Ada apa? Biarkan dia bebas?
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].indonesianFemaleNPCText
      value: Anda telah memberi kami layanan dengan biaya seumur hidup! Aku tidak
        akan pernah melupakan itu, wanita. Saya akan melepaskan ide-ide quixotic
        ini dan memulai hidup saya dengan awal yang bersih! Bahkan mungkin menikah...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].indonesianFemaleNPCText
      value: Jelas...
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].indonesianFemaleNPCText
      value: Jangan khawatir tentang kami, kami sudah pergi.
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].PlayerAnswer.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].Fog
      value: 
      objectReference: {fileID: 1625870247}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[0].Text
      value: "\u0427\u0442\u043E \u0432\u044B \u0442\u0443\u0442 \u0434\u0435\u043B\u0430\u0439\u0442\u0435?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[1].Text
      value: "(\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E)"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[2].Text
      value: "\u041D\u0438\u0447\u0435\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].Text
      value: "\u0412\u044B\u044F\u0441\u043D\u0438\u043B\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[1].Text
      value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C
        \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u044B \u0435\u0449\u0435
        \u0442\u0443\u0442?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[1].Text
      value: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E, \u0443\u0434\u0430\u0447\u0438
        \u0432\u0430\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C
        \u0432\u0430\u043C \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C
        \u043F\u0443\u0442\u044C \u043A \u043B\u043E\u0434\u043A\u0435."
      objectReference: {fileID: 0}
