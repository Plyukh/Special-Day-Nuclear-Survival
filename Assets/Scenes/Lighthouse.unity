    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0413\u043E\u0441\u043F\u043E\u0434\u0438, \u0447\u0442\u043E \u044F
        \u0434\u0435\u043B\u0430\u044E \u0441\u043E \u0441\u0432\u043E\u0435\u0439
