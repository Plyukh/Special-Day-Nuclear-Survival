      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0410\u0433\u0430, \u0434\u043E \u0441\u043A\u043E\u0440\u043E\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[0].answerType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0420\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044C
        \u043D\u0435 \u0432\u0438\u043D\u043E\u0432\u0430\u0442, \u0447\u0442\u043E
        \u0443 \u043D\u0435\u0433\u043E \u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u044B!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[0].SkillCheck
