    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].XP
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430, \u044D\u0442\u043E \u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[1].Text
      value: "\u0412\u044B \u043C\u0435\u043D\u044F \u0441 \u043A\u0435\u043C-\u0442\u043E
        \u0441\u043F\u0443\u0442\u0430\u043B\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[2].Text
      value: "\u041D\u0438\u0447\u0435\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].Text
      value: "\u041B\u0430\u0434\u043D\u043E..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[1].Text
      value: "\u0412\u044B \u043C\u0435\u043D\u044F \u0441 \u043A\u0435\u043C-\u0442\u043E
        \u0441\u043F\u0443\u0442\u0430\u043B\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].Text
      value: "\u0421 \u0442\u043E\u0431\u043E\u0439 \u0432\u0441\u0435 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[1].Text
      value: "\u0422\u043E\u043B\u044C\u043A\u043E \u0411\u043E\u0433 \u043C\u043E\u0436\u0435\u0442
        \u0440\u0435\u0448\u0430\u0442\u044C, \u043A\u0430\u043A \u043E\u043D\u0438
        \u0431\u0443\u0434\u0443\u0442 \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044C,
        \u043D\u043E \u043D\u0435 \u0442\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438, \u0442\u044B \u0438\u043C\u0435\u0435\u0448\u044C
        \u0432 \u0432\u0438\u0434\u0443 \u0433\u0440\u0438\u0431\u044B?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430, \u0434\u0430\u0432\u0430\u0439 \u043D\u0430\u0436\u0440\u0435\u043C\u0441\u044F
        \u0433\u0440\u0438\u0431\u043E\u0432."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].Text
      value: "\u0422\u044B \u0441\u043E\u0432\u0441\u0435\u043C \u0433\u043E\u043B\u043E\u0432\u0443
        \u043F\u043E\u0442\u0435\u0440\u044F\u043B, \u0443\u043A\u0443\u0440\u0435\u043D\u043D\u044B\u0439
        \u0433\u0430\u043D\u0434\u043E\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u043F\u043E\u0438\u0449\u0443 \u0433\u0440\u0438\u0431\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[1].Text
      value: "\u041E\u043D\u043E \u0438 \u043A \u043B\u0443\u0447\u0448\u0435\u043C\u0443,
        \u044F \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B \u0436\u0440\u0430\u0442\u044C
        \u0441 \u0442\u043E\u0431\u043E\u0439 \u044D\u0442\u043E \u0434\u0435\u0440\u044C\u043C\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[1].Text
      value: "\u041E\u043D\u043E \u0438 \u043A \u043B\u0443\u0447\u0448\u0435\u043C\u0443,
        \u044F \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B \u0436\u0440\u0430\u0442\u044C
        \u0441 \u0442\u043E\u0431\u043E\u0439 \u044D\u0442\u043E \u0434\u0435\u0440\u044C\u043C\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 6130296966573067829, guid: 9d271b241a43ac049a1f9c387e05ed58, type: 3}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[0].Text
      value: "\u0415\u0441\u043B\u0438 \u0442\u044B \u043F\u0440\u043E \u043A\u0440\u0430\u0441\u043D\u044B\u0435
        \u0433\u0440\u0438\u0431\u044B, \u0442\u043E \u044F \u043D\u0430\u0448\u0435\u043B
        \u043E\u0434\u0438\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[1].Text
      value: "\u0415\u0449\u0435 \u043D\u0435\u0442, \u0432\u043E\u043B\u043D \u043D\u0435
        \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[0].Text
      value: "\u041D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D, \u043D\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[8].PlayerAnswer.Array.data[1].Text
      value: "\u042D\u0442\u0438\u0445 \u044F \u043F\u043E\u043A\u0430 \u0435\u0449\u0435
        \u043D\u0435 \u043D\u0430\u0448\u0435\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u0438\u0437\u0434\u0435\u0446, \u0442\u044B \u043E\u0431\u044A\u0435\u0431\u0430\u043D\u043D\u044B\u0439
        \u0443\u0442\u044B\u0440\u043E\u043A."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[9].PlayerAnswer.Array.data[1].Text
      value: "\u042D\u0442\u0438\u0445 \u044F \u043F\u043E\u043A\u0430 \u0435\u0449\u0435
        \u043D\u0435 \u043D\u0430\u0448\u0435\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[1].Quest
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[0].PlayerAnswer.Array.data[2].Skill
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 690222907453984935, guid: feac83a032a426a4296b4023fafe9ff1, type: 3}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.data[0].Text
      value: "\u0411\u0435\u043B\u044B\u0439 \u0433\u0440\u0438\u0431? \u0414\u0430,
        \u0432\u043E\u0442 \u043E\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.data[1].Text
      value: "\u042D\u0442\u0438\u0445 \u044F \u043F\u043E\u043A\u0430 \u0435\u0449\u0435
        \u043D\u0435 \u043D\u0430\u0448\u0435\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430\u0432\u0430\u0439, \u0445\u0443\u0436\u0435 \u0443\u0436\u0435
        \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[1].Text
      value: "\u042D\u0442\u0438\u0445 \u044F \u043F\u043E\u043A\u0430 \u0435\u0449\u0435
        \u043D\u0435 \u043D\u0430\u0448\u0435\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[12].PlayerAnswer.Array.data[0].Text
      value: "\u042F \u0434\u0430\u0436\u0435... \u042F\u0437\u044B\u043A\u0443 \u043F\u0438\u0437\u0434\u0435\u0446..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 4432857142653439010, guid: 63a75a30795f11547ade56c154ecf5cc, type: 3}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].PlayerAnswer.Array.data[0].Text
      value: "\u0422\u044B \u0435\u0431\u0430\u043D\u0443\u043B\u0441\u044F? \u041A\u0430\u043A\u0438\u0435
        \"\u043A\u0430\u043C\u043D\u0438 \u0436\u0438\u0437\u043D\u0438\"? \u042D\u0442\u043E
        \u0442\u0430\u0431\u043B\u0435\u0442\u043A\u0438! \u0414\u0435\u0440\u0436\u0438..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[13].PlayerAnswer.Array.data[1].Text
      value: "\u0414\u0430\u0432\u0430\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u043E\u0431\u043E\u0439\u0434\u0435\u043C\u0441\u044F \u0431\u0435\u0437
        \"\u043A\u0430\u043C\u043D\u0435\u0439 \u0436\u0438\u0437\u043D\u0438\",
        \u0445\u043E\u0440\u043E\u0448\u043E?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].PlayerAnswer.Array.data[0].Text
      value: "\u0414\u0430\u0432\u0430\u0439 \u0431\u044B\u0441\u0442\u0440\u0435\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].PlayerAnswer.Array.data[1].Text
      value: "\u0414\u0430\u0432\u0430\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u043E\u0431\u043E\u0439\u0434\u0435\u043C\u0441\u044F \u0431\u0435\u0437
        \"\u043A\u0430\u043C\u043D\u0435\u0439 \u0436\u0438\u0437\u043D\u0438\",
        \u0445\u043E\u0440\u043E\u0448\u043E?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[15].PlayerAnswer.Array.data[0].Text
      value: "\u0410 \u044F \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0436\u0443!
        \u0412 \u043F\u0438\u0437\u0434\u0443 \u0442\u0435\u0431\u044F \u0438 \u0442\u0432\u043E\u044E
        \u043F\u0443\u0441\u0442\u043E\u0442\u0443!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[16].PlayerAnswer.Array.data[0].Item
      value: 
      objectReference: {fileID: 4437415279374824457, guid: 9c8c586629cd43844807bb7a5b8a40da, type: 3}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[16].PlayerAnswer.Array.data[0].Text
      value: "\u0411\u043B\u044F\u0442\u044C, \u0432\u044B\u0440\u0430\u0436\u0430\u0439\u0441\u044F
        \u044F\u0441\u043D\u0435\u0435! \u0422\u0430\u043A \u0438 \u0441\u043A\u0430\u0436\u0438,
        \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u0435\u043D
        \u0439\u043E\u0434\u0438\u0434 \u043A\u0430\u043B\u0438\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[16].PlayerAnswer.Array.data[1].Text
      value: "\u041A\u0430\u043A\u0438\u0445 \u0431\u0435\u043B\u044B\u0445?! \u041A\u0430\u043A\u0438\u0445
        \u0447\u0435\u0440\u043D\u044B\u0445?! \u0415\u0431\u0430\u043D\u044B\u0439
        \u0440\u043E\u0442..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[17].PlayerAnswer.Array.data[0].Item
