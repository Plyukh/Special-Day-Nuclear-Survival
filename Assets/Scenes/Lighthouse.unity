    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].FemaleText
      value: "\u042F \u043A \u0432\u0430\u0448\u0435\u043C\u0443 \u043B\u0438\u0434\u0435\u0440\u0443
        \u043F\u043E \u0434\u0435\u043B\u0443, \u043F\u043E\u0439\u043C\u0438\u0442\u0435
