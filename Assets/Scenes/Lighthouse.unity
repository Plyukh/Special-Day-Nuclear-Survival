      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0417\u0430 \u043A\u0430\u043A\u0438\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C
        \u0432\u044B \u043E\u0445\u043E\u0442\u0438\u0442\u0435\u0441\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[0].answerType
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[1].PlayerAnswer.Array.data[1].FemaleText
      value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C
        \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].FemaleText
      value: "\u042F \u043C\u043E\u0433\u0443 \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C,
        \u0431\u0435\u0437 \u043C\u0435\u043D\u044F \u0432\u0430\u043C \u043D\u0435
        \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[0].answerType
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[2].PlayerAnswer.Array.data[1].FemaleText
      value: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E, \u0443\u0434\u0430\u0447\u0438
        \u0432\u0430\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].FemaleText
      value: "\u042F \u0445\u043E\u0447\u0443 \u043F\u043E\u043C\u043E\u0447\u044C
        \u0432\u0430\u043C \u0434\u043E\u0431\u044B\u0442\u044C \u0420\u0423\u041D\u041E
        \u211613."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[0].answerType
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[1].FemaleText
      value: "\u0423\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
        \u0440\u0430\u0437."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[3].PlayerAnswer.Array.data[1].answerType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u044F \u0436\u0435\u043D\u0449\u0438\u043D\u0430,
        \u044F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].answerType
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].FemaleText
      value: "\u0421 \u0442\u0430\u043A\u0438\u043C \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435\u043C
        \u043A \u0436\u0435\u043D\u0449\u0438\u043D\u0430\u043C \u0442\u044B \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
        \u043E\u0441\u0442\u0430\u043D\u0435\u0448\u044C\u0441\u044F \u0434\u0435\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].answerType
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439,
        \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A..."
      objectReference: {fileID: 0}
