    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[1].FemaleText
      value: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[1].SkillCheck
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[1].answerType
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].FemaleText
      value: "\u041B\u0430\u0434\u043D\u043E, \u0442\u043E\u0433\u0434\u0430 \u044F
        \u0432\u0435\u0440\u043D\u0443\u0441\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].answerType
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[1].FemaleText
      value: "\u041A\u043E\u043D\u0435\u0446 \u0432\u0438\u0434\u0438\u0442\u0441\u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F,
        \u0434\u0440\u0443\u0433 \u043C\u043E\u0439 \u0431\u0435\u0441\u043A\u043E\u0436\u0438\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[1].answerType
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0413\u043E\u0441\u043F\u043E\u0434\u0438, \u0447\u0442\u043E \u044F
        \u0434\u0435\u043B\u0430\u044E \u0441\u043E \u0441\u0432\u043E\u0435\u0439
        \u0436\u0438\u0437\u043D\u044C\u044E?"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[7].PlayerAnswer.Array.data[0].answerType
