    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0443\u0436\u0435 \u0437\u0430\u0439\u043C\u0435\u043C\u0441\u044F
        \u0434\u0435\u043B\u043E\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].answerType
      value: 5
