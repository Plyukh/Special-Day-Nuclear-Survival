      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].FemaleText
      value: "\u0421 \u0442\u0430\u043A\u0438\u043C \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435\u043C
        \u043A \u0436\u0435\u043D\u0449\u0438\u043D\u0430\u043C \u0442\u044B \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
        \u043E\u0441\u0442\u0430\u043D\u0435\u0448\u044C\u0441\u044F \u0434\u0435\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[1].answerType
