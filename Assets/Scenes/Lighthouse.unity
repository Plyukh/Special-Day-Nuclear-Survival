      propertyPath: nodes.Array.data[17].PlayerAnswer.Array.data[0].FemaleText
      value: "\u042D\u0442\u043E \u0443\u0436\u0435 \u043D\u0435\u0432\u0430\u0436\u043D\u043E.
        \u0414\u0430\u0432\u0430\u0439 \u0435\u0431\u0430\u0448\u0438\u0442\u044C
        \u0442\u0432\u043E\u044E \u0441\u043C\u0435\u0441\u044C."
