      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[0].FemaleText
      value: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[5].PlayerAnswer.Array.data[0].SkillCheck
