    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[16].PlayerAnswer.Array.data[1].EngFemaleText
      value: Which white ones?! What kind of black?! Fucking fucked up...
