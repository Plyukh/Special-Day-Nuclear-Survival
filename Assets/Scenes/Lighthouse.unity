      propertyPath: nodes.Array.data[14].PlayerAnswer.Array.data[0].FemaleText
      value: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0438\u0437\u0434\u0435\u0446..."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[14].PlayerAnswer.Array.data[0].answerType
