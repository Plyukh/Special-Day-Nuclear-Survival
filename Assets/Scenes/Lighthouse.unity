      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[0].FemaleText
      value: "\u042F \u0437\u0430\u0447\u0438\u0441\u0442\u0438\u043B\u0430 \u043F\u0435\u0449\u0435\u0440\u044B.
        \u0412\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u0435\u0439 \u0431\u043E\u043B\u044C\u0448\u0435
        \u043D\u0435\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[0].answerType
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[1].FemaleText
      value: "\u0417\u0430\u0447\u0438\u0441\u0442\u043A\u0430 \u043F\u0435\u0449\u0435\u0440
        \u0438\u0434\u0435\u0442 \u043F\u043E\u043B\u043D\u044B\u043C \u0445\u043E\u0434\u043E\u043C.
        \u0412\u0435\u0440\u043D\u0443\u0441\u044C \u043F\u043E\u0437\u0436\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[11].PlayerAnswer.Array.data[1].answerType
      value: 1
      objectReference: {fileID: 0}
