      propertyPath: nodes.Array.data[6].PlayerAnswer.Array.data[0].Text
      value: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0433\u0440\u0443\u043F\u043F\u0430
        \"\u0420\u0443\u0434\u043D\u0438\u043A\"?"
      objectReference: {fileID: 0}
