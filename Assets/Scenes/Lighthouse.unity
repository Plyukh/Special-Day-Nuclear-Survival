      propertyPath: nodes.Array.data[4].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u044F \u0436\u0435\u043D\u0449\u0438\u043D\u0430,
        \u044F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E."
