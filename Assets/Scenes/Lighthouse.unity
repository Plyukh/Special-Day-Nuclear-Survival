      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.data[0].FemaleText
      value: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043D\u044F\u0442\u043D\u043E,
        \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 6430975673304087550, guid: 9bc7cc6a6b467c24ebe62fcc5db6af7c, type: 3}
      propertyPath: nodes.Array.data[10].PlayerAnswer.Array.data[0].answerType
      value: 1
      objectReference: {fileID: 0}
